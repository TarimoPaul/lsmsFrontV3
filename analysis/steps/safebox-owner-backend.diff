+        recon.setUserUid(CASHIER_UID);
+        ReconciliationCashEntry entry = new ReconciliationCashEntry();
+        entry.setUid(CASH_ENTRY_UID);
+        entry.setEntryType("SAFE_BOX");
+        entry.setAmount(new BigDecimal("30000"));
+        entry.setReconciliation(recon);
+        return entry;
+    }
