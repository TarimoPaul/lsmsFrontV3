diff --git a/src/main/resources/db/migration/V133__Safe_Box_Deposit_Owner_And_On_Behalf.sql b/src/main/resources/db/migration/V133__Safe_Box_Deposit_Owner_And_On_Behalf.sql
new file mode 100644
index 0000000..939d20a
--- /dev/null
+++ b/src/main/resources/db/migration/V133__Safe_Box_Deposit_Owner_And_On_Behalf.sql
@@ -0,0 +1,38 @@
+-- V133: a safe box deposit records BOTH who submitted it (cashier_uid, unchanged) and
+-- whose money it is (owner_uid = the user of the reconciliation the entry belongs to).
+-- An ordinary user may submit only against their own entries; submitting for someone
+-- else needs the new SAFEBOX_DEPOSIT_ON_BEHALF permission, and such a deposit is the
+-- one where cashier_uid <> owner_uid ("kwa niaba").
+-- Additive only: no existing value is changed. owner_uid is filled for existing rows
+-- from their source reconciliation.
+
+ALTER TABLE safe_box_deposits
+    ADD COLUMN IF NOT EXISTS owner_uid VARCHAR(255);
+
+UPDATE safe_box_deposits sbd
+SET owner_uid = dr.user_uid
+FROM daily_reconciliation dr
+WHERE dr.uid = sbd.source_recon_uid
+  AND sbd.owner_uid IS NULL;
+
+INSERT INTO permissions (uid, name, module, group_name, description, is_active, is_deleted, created_at, updated_at)
+SELECT
+    gen_random_uuid()::VARCHAR(255),
+    'SAFEBOX_DEPOSIT_ON_BEHALF',
+    'RECONCILIATION',
+    'RECONCILIATION_MANAGEMENT',
+    'Wasilisha deposit/hand-over ya Safe Box kwa niaba ya cashier mwingine',
+    TRUE, FALSE, NOW(), NOW()
+WHERE NOT EXISTS (SELECT 1 FROM permissions WHERE name = 'SAFEBOX_DEPOSIT_ON_BEHALF');
+
+-- Granted to the CEO role only (ROOT holds every authority through its wildcard).
+-- No other role gets it here; it can be assigned later from the roles screen.
+INSERT INTO role_permissions (role_uid, permission_uid)
+SELECT r.uid, p.uid
+FROM roles r
+JOIN permissions p ON p.name = 'SAFEBOX_DEPOSIT_ON_BEHALF'
+WHERE UPPER(r.name) = 'CEO'
+  AND NOT EXISTS (
+    SELECT 1 FROM role_permissions rp
+    WHERE rp.role_uid = r.uid AND rp.permission_uid = p.uid
+  );
