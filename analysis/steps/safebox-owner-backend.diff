+        d.setCashEntryUid(CASH_ENTRY_UID);
+        d.setCashierUid(submitterUid);
+        d.setOwnerUid(CASHIER_UID);
+        d.setSubmittedAmount(new BigDecimal("10000"));
+        d.setDepositType("BANK_DEPOSIT");
+        d.setBankName("CRDB");
+        d.setStatus("PENDING");
+        d.setSubmittedAt(LocalDateTime.now());
+        return d;
+    }
