diff --git a/src/main/java/com/Lsms/CapitalAndExpenditure/gl/GlPeriodService.java b/src/main/java/com/Lsms/CapitalAndExpenditure/gl/GlPeriodService.java
new file mode 100644
index 0000000..4c52bf5
--- /dev/null
+++ b/src/main/java/com/Lsms/CapitalAndExpenditure/gl/GlPeriodService.java
@@ -0,0 +1,163 @@
+package com.Lsms.CapitalAndExpenditure.gl;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+import lombok.RequiredArgsConstructor;
+import lombok.extern.slf4j.Slf4j;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+import java.time.LocalDate;
+import java.time.LocalDateTime;
+import java.time.YearMonth;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Closing and reopening GL months (MPANGO-PAMOJA §1.9). A CLOSED month takes no new
+ * journal on its dates: a system event is booked on the first open day with its real
+ * date in event_date (PostingEngine.executePost), and a manual journal is refused
+ * until the month is reopened. Every close and reopen is written to gl_period_audit.
+ */
+@Service
+@RequiredArgsConstructor
+@Slf4j
+public class GlPeriodService {
+
+    public static final String OPEN = "OPEN";
+    public static final String CLOSED = "CLOSED";
+
+    private static final ObjectMapper JSON = new ObjectMapper().findAndRegisterModules();
+    private static final int MAX_MONTHS_LISTED = 36;
+
+    private final GlPeriodRepository periodRepository;
+    private final GlPeriodAuditRepository auditRepository;
+    private final GlPostingFailureRepository failureRepository;
+    private final GlReconciliationService glReconciliationService;
+    private final JournalEntryRepository journalEntryRepository;
+
+    /**
+     * Every month from the first journal's month to now (newest first, at most 36) with
+     * its status; months never closed are OPEN.
+     */
+    @Transactional(readOnly = true)
+    public List<Map<String, Object>> list() {
+        Map<YearMonth, GlPeriod> stored = new LinkedHashMap<>();
+        for (GlPeriod p : periodRepository.findByBranchUidIsNullOrderByPeriodYearDescPeriodMonthDesc()) {
+            stored.put(YearMonth.of(p.getPeriodYear(), p.getPeriodMonth()), p);
+        }
+        List<Map<String, Object>> out = new ArrayList<>();
+        LocalDate first = journalEntryRepository.findFirstEntryDate();
+        YearMonth oldest = first != null ? YearMonth.from(first) : YearMonth.now();
+        YearMonth m = YearMonth.now();
+        for (int i = 0; i < MAX_MONTHS_LISTED && !m.isBefore(oldest); i++, m = m.minusMonths(1)) {
+            GlPeriod p = stored.get(m);
+            Map<String, Object> row = new LinkedHashMap<>();
+            row.put("year", m.getYear());
+            row.put("month", m.getMonthValue());
+            row.put("status", p != null && p.getStatus() != null ? p.getStatus() : OPEN);
+            row.put("closedAt", p != null ? p.getClosedAt() : null);
+            row.put("closedBy", p != null ? p.getClosedBy() : null);
+            row.put("current", m.equals(YearMonth.now()));
+            out.add(row);
+        }
+        return out;
+    }
+
+    @Transactional(readOnly = true)
+    public List<GlPeriodAudit> audit(Integer year, Integer month) {
+        return year != null && month != null
+                ? auditRepository.findByPeriodYearAndPeriodMonthOrderByAtDesc(year, month)
+                : auditRepository.findTop100ByOrderByAtDesc();
+    }
+
+    /**
+     * Closes one past month. Refused for the current or a future month, and while a
+     * GL posting failure dated in that month is still open.
+     */
+    @Transactional
+    public Map<String, Object> close(int year, int month, String reason, String byUid, String byName) {
+        YearMonth ym = YearMonth.of(year, month);
+        if (!ym.isBefore(YearMonth.now())) {
+            throw new IllegalStateException("Mwezi " + ym + " bado haujaisha; unaweza kufunga mwezi uliopita tu.");
+        }
+        GlPeriod p = periodRepository.findByPeriodYearAndPeriodMonthAndBranchUidIsNull(year, month).orElse(null);
+        if (p != null && !OPEN.equals(p.getStatus())) {
+            throw new IllegalStateException("Mwezi " + ym + " tayari umefungwa.");
+        }
+        LocalDate from = ym.atDay(1), to = ym.atEndOfMonth();
+        long openFailures = failureRepository.findByResolvedAtIsNullOrderByCreatedAtDesc().stream()
+                .filter(f -> f.getEntryDate() != null && !f.getEntryDate().isBefore(from) && !f.getEntryDate().isAfter(to))
+                .count();
+        if (openFailures > 0) {
+            throw new IllegalStateException("Mwezi " + ym + " una makosa " + openFailures
+                    + " ya GL yasiyotatuliwa; yatatue kwanza (Jaribu tena).");
+        }
+
+        Map<String, Object> checks = new LinkedHashMap<>();
+        checks.put("asOf", to.toString());
+        checks.put("openPostingFailures", 0);
+        // Informational only, never a gate: controlChecks still has RIPOTI H-9 (GL as of the
+        // month end is compared with TODAY's sub-ledgers), so a difference here is expected.
+        checks.put("controlChecksNote", "informational; controlChecks ina H-9 (GL ya " + to
+                + " dhidi ya sub-ledger za leo) - haizuii kufunga");
+        try {
+            checks.put("controlChecks", glReconciliationService.controlChecks(to));
+        } catch (Exception e) {
+            checks.put("controlChecksError", e.getMessage());
+        }
+
+        if (p == null) {
+            p = new GlPeriod();
+            p.setPeriodYear(year);
+            p.setPeriodMonth(month);
+            p.setPeriodName(ym.toString());
+        }
+        p.setStatus(CLOSED);
+        p.setClosedAt(LocalDateTime.now());
+        p.setClosedBy(byName);
+        p.setClosedByUid(byUid);
+        p.setChecksJson(toJson(checks));
+        periodRepository.save(p);
+        writeAudit(year, month, "CLOSE", reason, byUid, byName);
+        log.info("GL period {} CLOSED by {}", ym, byName);
+        return checks;
+    }
+
+    /** Reopens a closed month; a reason of at least 10 characters is required. */
+    @Transactional
+    public void reopen(int year, int month, String reason, String byUid, String byName) {
+        YearMonth ym = YearMonth.of(year, month);
+        if (reason == null || reason.trim().length() < 10) {
+            throw new IllegalArgumentException("Sababu ya kufungua upya inahitajika (angalau herufi 10).");
+        }
+        GlPeriod p = periodRepository.findByPeriodYearAndPeriodMonthAndBranchUidIsNull(year, month)
+                .filter(x -> !OPEN.equals(x.getStatus()))
+                .orElseThrow(() -> new IllegalStateException("Mwezi " + ym + " haujafungwa."));
+        p.setStatus(OPEN);
+        p.setOpenedAt(LocalDateTime.now());
+        periodRepository.save(p);
+        writeAudit(year, month, "REOPEN", reason.trim(), byUid, byName);
+        log.warn("GL period {} REOPENED by {}: {}", ym, byName, reason.trim());
+    }
+
+    private void writeAudit(int year, int month, String action, String reason, String byUid, String byName) {
+        GlPeriodAudit a = new GlPeriodAudit();
+        a.setPeriodYear(year);
+        a.setPeriodMonth(month);
+        a.setAction(action);
+        a.setReason(reason != null && !reason.isBlank() ? reason.trim() : null);
+        a.setByUid(byUid);
+        a.setByName(byName);
+        auditRepository.save(a);
+    }
+
+    private static String toJson(Object o) {
+        try {
+            return JSON.writeValueAsString(o);
+        } catch (Exception e) {
+            return null;
+        }
+    }
+}
