+        return new Response<>(glPeriodService.audit(year, month));
+    }
+
+    @Operation(summary = "Close a past GL month")
+    @PostMapping("/periods/{year}/{month}/close")
+    @PreAuthorize("hasPermission(null, 'FINANCE_WRITE')")
+    public Response<java.util.Map<String, Object>> closePeriod(@PathVariable int year, @PathVariable int month,
+                                                               @RequestBody(required = false) java.util.Map<String, Object> body) {
+        try {
+            String reason = body != null && body.get("reason") != null ? String.valueOf(body.get("reason")) : null;
+            return new Response<>(ResponseStatus.Success, glPeriodService.close(year, month, reason,
+                    com.Lsms.uaa.utils.LoggedUser.getUid(), com.Lsms.uaa.utils.LoggedUser.getName()),
+                    "Mwezi umefungwa");
+        } catch (IllegalArgumentException | IllegalStateException | java.time.DateTimeException e) {
+            return new Response<>(ResponseStatus.Error, null, e.getMessage());
+        }
+    }
+
+    @Operation(summary = "Reopen a closed GL month (reason required, audited)")
+    @PostMapping("/periods/{year}/{month}/reopen")
+    @PreAuthorize("hasPermission(null, 'FINANCE_WRITE')")
+    public Response<Void> reopenPeriod(@PathVariable int year, @PathVariable int month,
+                                       @RequestBody java.util.Map<String, Object> body) {
+        try {
+            String reason = body != null && body.get("reason") != null ? String.valueOf(body.get("reason")) : null;
+            glPeriodService.reopen(year, month, reason,
+                    com.Lsms.uaa.utils.LoggedUser.getUid(), com.Lsms.uaa.utils.LoggedUser.getName());
+            return new Response<>(ResponseStatus.Success, null, "Mwezi umefunguliwa upya");
+        } catch (IllegalArgumentException | IllegalStateException | java.time.DateTimeException e) {
+            return new Response<>(ResponseStatus.Error, null, e.getMessage());
+        }
+    }
 }
