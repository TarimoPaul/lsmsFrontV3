@@ -0,0 +1,42 @@
+package com.Lsms.CapitalAndExpenditure.gl;
+
+import java.time.LocalDate;
+import java.util.List;
+
+/**
+ * Thrown by {@link PostingEngine#post} when a journal could not be written. Carries
+ * the whole posting request so a caller that continues without the journal can
+ * record it in gl_posting_failure with enough detail to retry it.
+ */
+public class GlPostingException extends RuntimeException {
+
+    private final JournalEventType eventType;
+    private final String referenceUid;
+    private final String referenceNumber;
+    private final LocalDate entryDate;
+    private final String branchUid;
+    private final String postedBy;
+    private final List<PostingEngine.JournalLine> lines;
+
+    public GlPostingException(JournalEventType eventType, String referenceUid, String referenceNumber,
+                              LocalDate entryDate, String branchUid, String postedBy,
+                              List<PostingEngine.JournalLine> lines, Throwable cause) {
+        super("GL post failed for " + eventType + " ref=" + referenceUid
+                + (cause != null && cause.getMessage() != null ? ": " + cause.getMessage() : ""), cause);
+        this.eventType = eventType;
+        this.referenceUid = referenceUid;
+        this.referenceNumber = referenceNumber;
+        this.entryDate = entryDate;
+        this.branchUid = branchUid;
+        this.postedBy = postedBy;
+        this.lines = lines != null ? List.copyOf(lines) : List.of();
+    }
+
+    public JournalEventType getEventType() { return eventType; }
+    public String getReferenceUid() { return referenceUid; }
+    public String getReferenceNumber() { return referenceNumber; }
+    public LocalDate getEntryDate() { return entryDate; }
+    public String getBranchUid() { return branchUid; }
+    public String getPostedBy() { return postedBy; }
+    public List<PostingEngine.JournalLine> getLines() { return lines; }
+}
diff --git a/src/main/java/com/Lsms/CapitalAndExpenditure/gl/GlPostingFailure.java b/src/main/java/com/Lsms/CapitalAndExpenditure/gl/GlPostingFailure.java
new file mode 100644
