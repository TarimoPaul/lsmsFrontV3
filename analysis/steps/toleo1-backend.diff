+package com.Lsms.CapitalAndExpenditure.gl;
+
+import com.Lsms.DebtAdjustment.Entity.DebtAdjustment;
+import com.Lsms.DebtAdjustment.Enums.DebtAdjustmentStatus;
+import com.Lsms.DebtAdjustment.Repository.DebtAdjustmentRepository;
+import com.Lsms.Enums.SaleSource;
+import com.Lsms.Payments.Entity.Payment;
+import com.Lsms.Payments.Repository.PaymentRepository;
+import com.Lsms.Sales.Entity.Sales;
+import com.Lsms.Sales.Repository.SalesRepository;
+import lombok.RequiredArgsConstructor;
+import lombok.extern.slf4j.Slf4j;
+import org.springframework.context.ApplicationContext;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Propagation;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.transaction.support.TransactionSynchronization;
+import org.springframework.transaction.support.TransactionSynchronizationManager;
+
+import java.math.BigDecimal;
+import java.util.List;
+
+/**
+ * Posts a POS sale's journal from the sale AS STORED (RIPOTI H-2 fix).
+ *
+ * The old hook posted the in-memory Sales entity on another thread. Its
+ * outstandingBalance was still the default 0, because the real figure is written by
+ * {@code SalesRepository.syncPaymentStatusByUid}, a native UPDATE that never touches
+ * the managed entity. A credit or part-paid sale therefore lost its AR line, the
+ * journal did not balance, and the failure was only logged.
+ *
+ * Now the journal is posted after the sale's transaction commits, on the same
+ * thread, by re-reading the sale, its payments and its approved debt adjustments in
+ * a fresh transaction — the same figures the GL backfill uses. A failure is kept in
+ * gl_posting_failure and can be retried.
+ */
+@Service
+@RequiredArgsConstructor
+@Slf4j
+public class SaleGlPostingService {
+
+    private final SalesRepository salesRepository;
+    private final PaymentRepository paymentRepository;
+    private final DebtAdjustmentRepository debtAdjustmentRepository;
+    private final JournalEntryRepository journalEntryRepository;
+    private final PostingEngine postingEngine;
+    private final GlPostingFailureService failureService;
+    private final ApplicationContext applicationContext;
+
+    /**
+     * Posts the sale once the surrounding transaction has committed (immediately when
+     * there is none). Never throws: a failure is recorded and the sale stands.
+     */
+    public void postAfterCommit(String saleUid, String receiptNumber, String postedBy) {
+        if (saleUid == null) return;
+        Runnable task = () -> postOrRecord(saleUid, receiptNumber, postedBy);
+        if (TransactionSynchronizationManager.isSynchronizationActive()) {
+            TransactionSynchronizationManager.registerSynchronization(new TransactionSynchronization() {
+                @Override
+                public void afterCommit() {
+                    task.run();
+                }
+            });
+        } else {
+            task.run();
+        }
+    }
+
+    private void postOrRecord(String saleUid, String receiptNumber, String postedBy) {
+        try {
+            applicationContext.getBean(SaleGlPostingService.class).postFromDb(saleUid, postedBy);
+        } catch (Exception e) {
+            log.error("GL postSale failed for {}: {}", receiptNumber, GlPostingFailureService.messageChain(e));
+            failureService.record(GlPostingFailureService.SOURCE_SALE, saleUid, receiptNumber, e);
+        }
+    }
+
+    /** The event types a POS sale journal is posted under (PostingEngine.postSale). */
+    static final List<JournalEventType> SALE_TYPES =
+            List.of(JournalEventType.SALE_CASH, JournalEventType.SALE_CREDIT, JournalEventType.SALE_MIXED);
+
+    /**
+     * Posts one sale from the database; throws on failure. Approved debt adjustments
+     * are posted on top, as the backfill does.
+     *
+     * Idempotent: a sale that already has a live, unreversed SALE_* journal is never
+     * posted again — the open failure is resolved and ALREADY_POSTED returned, so a
+     * second retry (or a retry after the after-commit post did succeed) adds nothing.
+     *
+     * Walk-in debts (RECONCILIATION_MANUAL) are never posted as revenue here: their
+     * goods left through a normal POS sale already; they post only the AR reclass.
+     */
+    @Transactional(propagation = Propagation.REQUIRES_NEW, timeout = 60)
+    public GlPostOutcome postFromDb(String saleUid, String postedBy) {
+        Sales sale = salesRepository.findByUidWithAllRelationships(saleUid)
+                .orElseThrow(() -> new IllegalStateException("Sale haipo au si active: " + saleUid));
+        if (Boolean.TRUE.equals(sale.getIsDeleted())) {
+            throw new IllegalStateException("Sale imefutwa: " + sale.getReceiptNumber());
+        }
+        if (sale.getSaleSource() == SaleSource.RECONCILIATION_MANUAL) {
+            log.info("Sale {} is a walk-in debt - only its AR reclass is posted, not revenue", sale.getReceiptNumber());
+            return GlPostOutcome.NOTHING_TO_POST;
+        }
+        String by = postedBy != null ? postedBy : "SYSTEM";
+        if (hasLiveSaleJournal(saleUid)) {
+            log.info("Sale {} already has a live journal - not posted again", sale.getReceiptNumber());
+            failureService.resolveBySource(saleUid, by, GlPostOutcome.ALREADY_POSTED.name());
+            return GlPostOutcome.ALREADY_POSTED;
+        }
+        // The sale is posted as it stood when it was made. Money collected later already has
+        // its own PAYMENT_RECEIVED journal (Dr cash / Cr AR, ref "<paymentUid>:RCPT:..."), so
+        // that part is taken out of the payment and put back on AR — otherwise reposting an
+        // old sale (H-2: 121026-2249, paid 175,000 on 13/10) would count that cash twice.
+        BigDecimal collectedLater = BigDecimal.ZERO;
+        List<Payment> payments = new java.util.ArrayList<>();
+        for (Payment p : paymentRepository.findBySaleUid(saleUid)) {
+            if (Boolean.FALSE.equals(p.getIsActive())) continue;
+            BigDecimal later = postedCollections(p.getUid());
+            if (later.signum() <= 0) {
+                payments.add(p);
+                continue;
+            }
+            collectedLater = collectedLater.add(later);
+            payments.add(saleTimeCopy(p, later));
+        }
+        BigDecimal corrected = debtAdjustmentRepository.sumApprovedAmountBySaleUid(saleUid);
+        if (corrected == null) corrected = BigDecimal.ZERO;
+
+        try (AutoCloseable ignored = postingEngine.withThrowOnError()) {
+            postingEngine.postSale(sale, payments, by, corrected.add(collectedLater));
+            if (corrected.signum() > 0) {
+                for (DebtAdjustment adj : debtAdjustmentRepository.findBySaleUidAndIsDeletedFalse(saleUid)) {
+                    if (adj.getStatus() == DebtAdjustmentStatus.APPROVED) postingEngine.postDebtAdjustment(adj, sale, by);
+                }
+            }
+        } catch (RuntimeException e) {
+            throw e;
+        } catch (Exception e) {
+            throw new IllegalStateException(e.getMessage(), e);
+        }
+        // postSale throws on a failed post, so no journal here means the sale produced no
+        // lines at all (a zero sale): nothing to post, as before.
+        if (!hasLiveSaleJournal(saleUid)) return GlPostOutcome.NOTHING_TO_POST;
+        failureService.resolveBySource(saleUid, by, "POSTED");
+        return GlPostOutcome.POSTED;
+    }
+
+    private boolean hasLiveSaleJournal(String saleUid) {
+        for (JournalEventType t : SALE_TYPES) {
+            if (postingEngine.hasActivePosting(t.name(), saleUid)) return true;
+        }
+        return false;
+    }
+
+    /** Cash already posted as later collections on one payment row (live, non-reversed RCPT journals). */
+    private BigDecimal postedCollections(String paymentUid) {
+        BigDecimal sum = BigDecimal.ZERO;
+        if (paymentUid == null) return sum;
+        for (JournalEntry e : journalEntryRepository
+                .findByReferenceUidStartingWithAndIsReversalFalseAndIsDeletedFalse(paymentUid + ":RCPT:")) {
+            if (journalEntryRepository.existsByReversedEntryUidAndIsDeletedFalse(e.getUid())) continue;
+            if (e.getTotalDebit() != null) sum = sum.add(e.getTotalDebit());
+        }
+        return sum;
+    }
+
+    /**
+     * A detached copy of a payment with what was collected later taken out. Never the
+     * managed entity: changing that would be flushed back to the payments table.
+     */
+    private static Payment saleTimeCopy(Payment p, BigDecimal collectedLater) {
+        Payment c = new Payment();
+        c.setUid(p.getUid());
+        c.setPaymentMethod(p.getPaymentMethod());
+        c.setPaymentStatus(p.getPaymentStatus());
+        c.setTotalAmount(p.getTotalAmount());
+        c.setIsDeleted(p.getIsDeleted());
+        BigDecimal paid = p.getAmountPaid() != null ? p.getAmountPaid() : BigDecimal.ZERO;
+        c.setAmountPaid(paid.subtract(collectedLater).max(BigDecimal.ZERO));
+        return c;
+    }
+}
