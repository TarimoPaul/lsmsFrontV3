+package com.Lsms.CapitalAndExpenditure.gl;
+
+import com.fasterxml.jackson.core.type.TypeReference;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import lombok.RequiredArgsConstructor;
+import lombok.extern.slf4j.Slf4j;
+import org.springframework.context.ApplicationContext;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Propagation;
+import org.springframework.transaction.annotation.Transactional;
+
+import java.time.LocalDateTime;
+import java.util.List;
+
+/**
+ * Keeps a row for every GL posting a business flow caught and continued without
+ * (MPANGO-PAMOJA §1.1/§1.4). Before this, such failures were a log line only, which
+ * is how three credit sales lived for days without a journal (RIPOTI H-2).
+ *
+ * Retry re-derives the journal from the source record where the attempted lines can
+ * themselves be wrong (a sale, a day close); any other source replays the lines that
+ * were attempted.
+ */
+@Service
+@RequiredArgsConstructor
+@Slf4j
+public class GlPostingFailureService {
+
+    public static final String SOURCE_SALE = "SALE";
+    public static final String SOURCE_DAY_CLOSE = "DAY_CLOSE";
+
+    private static final ObjectMapper JSON = new ObjectMapper().findAndRegisterModules();
+    private static final int MAX_ERROR = 2000;
+
+    private final GlPostingFailureRepository repository;
+    private final ApplicationContext applicationContext;
+
+    /**
+     * Records (or bumps the attempt count of) the open failure for one source record.
+     * Runs in its own transaction and never throws: it is called from catch blocks
+     * whose whole point is that the business flow carries on.
+     */
+    @Transactional(propagation = Propagation.REQUIRES_NEW)
+    public void record(String sourceType, String sourceUid, String sourceNumber, Throwable error) {
+        try {
+            String type = sourceType != null ? sourceType : "UNKNOWN";
+            String uid = sourceUid != null ? sourceUid : "?";
+            GlPostingFailure f = repository.findFirstBySourceTypeAndSourceUidAndResolvedAtIsNull(type, uid)
+                    .orElse(null);
+            if (f == null) {
+                f = new GlPostingFailure();
+                f.setSourceType(type);
+                f.setSourceUid(uid);
+                f.setAttempts(1);
+            } else {
+                f.setAttempts((f.getAttempts() != null ? f.getAttempts() : 0) + 1);
+                f.setLastAttemptAt(LocalDateTime.now());
+            }
+            if (sourceNumber != null) f.setSourceNumber(sourceNumber);
+            fillFromError(f, error);
+            repository.save(f);
+            log.error("GL posting failure recorded: {} {} ({}) attempt {}: {}",
+                    type, uid, f.getSourceNumber(), f.getAttempts(), f.getError());
+        } catch (Exception e) {
+            log.error("Could not record GL posting failure for {} {}: {} (original: {})",
+                    sourceType, sourceUid, e.getMessage(), error != null ? error.getMessage() : null);
+        }
+    }
+
+    /** Marks every open failure of a source record resolved (it now has its journal). */
+    @Transactional(propagation = Propagation.REQUIRES_NEW)
+    public void resolveBySource(String sourceUid, String byUid, String resolution) {
+        if (sourceUid == null) return;
+        try {
+            for (GlPostingFailure f : repository.findBySourceUidAndResolvedAtIsNull(sourceUid)) {
+                markResolved(f, byUid, resolution);
+                repository.save(f);
+            }
+        } catch (Exception e) {
+            log.warn("Could not resolve GL posting failures for {}: {}", sourceUid, e.getMessage());
+        }
+    }
+
+    @Transactional(readOnly = true)
+    public List<GlPostingFailure> list(boolean openOnly) {
+        return openOnly ? repository.findByResolvedAtIsNullOrderByCreatedAtDesc()
+                : repository.findTop200ByOrderByCreatedAtDesc();
+    }
+
+    @Transactional(readOnly = true)
+    public long countOpen() {
+        return repository.countByResolvedAtIsNull();
+    }
+
+    /**
+     * Tries the posting again. Success (the reference now has a live journal, or the
+     * source needs none) resolves the row; failure bumps attempts and keeps the new
+     * error. Not transactional itself: each posting commits in its own transaction.
+     */
+    public GlPostingFailure retry(String failureUid, String byUid) {
+        GlPostingFailure f = repository.findByUid(failureUid)
+                .orElseThrow(() -> new IllegalArgumentException("Kosa la GL halipo: " + failureUid));
+        if (f.getResolvedAt() != null) return f;
+        PostingEngine engine = applicationContext.getBean(PostingEngine.class);
+        String reference = f.getReferenceUid() != null ? f.getReferenceUid() : f.getSourceUid();
+        try {
+            String resolution;
+            switch (f.getSourceType()) {
+                case SOURCE_SALE -> {
+                    GlPostOutcome o = applicationContext.getBean(SaleGlPostingService.class)
+                            .postFromDb(f.getSourceUid(), byUid);
+                    reference = f.getSourceUid();
+                    resolution = resolutionOf(o);
+                }
+                case SOURCE_DAY_CLOSE -> {
+                    GlPostOutcome o = applicationContext.getBean(DayCloseVarianceService.class)
+                            .postCurrent(f.getSourceUid(), byUid);
+                    reference = f.getSourceUid();
+                    resolution = resolutionOf(o);
+                }
+                case DayCloseVarianceService.SOURCE_CORRECTION ->
+                    // The failed step may be the reversal, so re-posting alone could leave the
+                    // wrong journal live. The correction itself is idempotent: run it again.
+                        throw new IllegalStateException("Rudia marekebisho: POST /api/v1/gl/corrections/day-close-variance "
+                                + "(dryRun=true kwanza). Safu hii itatatuliwa yenyewe snapshot ikirekebishwa.");
+                default -> {
+                    List<PostingEngine.JournalLine> lines = readLines(f.getLinesJson());
+                    if (lines.isEmpty() || f.getEventType() == null) {
+                        throw new IllegalStateException("Kosa hili halina mistari ya journal iliyohifadhiwa; "
+                                + "rekebisha kwa journal ya mkono. / No stored lines to replay.");
+                    }
+                    engine.replay(JournalEventType.valueOf(f.getEventType()), reference, f.getSourceNumber(),
+                            f.getEntryDate(), f.getBranchUid(), byUid, lines);
+                    resolution = "RETRIED";
+                }
+            }
+            if ("RETRIED".equals(resolution) && !engine.hasActivePosting(reference)) {
+                throw new IllegalStateException("Retry ilimalizika lakini hakuna journal hai ya " + reference);
+            }
+            markResolved(f, byUid, resolution);
+        } catch (Exception e) {
+            f.setAttempts((f.getAttempts() != null ? f.getAttempts() : 0) + 1);
+            f.setLastAttemptAt(LocalDateTime.now());
+            fillFromError(f, e);
+            log.warn("GL retry of {} {} failed: {}", f.getSourceType(), f.getSourceUid(), f.getError());
+        }
+        return repository.save(f);
+    }
+
+    // ── helpers ──────────────────────────────────────────────────────────────
+
+    /** POSTED is checked for a live journal by the caller; the rest need no journal. */
+    private static String resolutionOf(GlPostOutcome o) {
+        return o == GlPostOutcome.POSTED ? "RETRIED" : o.name();
+    }
+
+    private static void markResolved(GlPostingFailure f, String byUid, String resolution) {
+        f.setResolvedAt(LocalDateTime.now());
+        f.setResolvedByUid(byUid);
+        f.setResolution(resolution);
+    }
+
+    private static void fillFromError(GlPostingFailure f, Throwable error) {
+        if (error instanceof GlPostingException g) {
+            f.setEventType(g.getEventType() != null ? g.getEventType().name() : null);
+            f.setReferenceUid(g.getReferenceUid());
+            if (f.getSourceNumber() == null) f.setSourceNumber(g.getReferenceNumber());
+            f.setEntryDate(g.getEntryDate());
+            f.setBranchUid(g.getBranchUid());
+            f.setPostedBy(g.getPostedBy());
+            f.setLinesJson(writeLines(g.getLines()));
+        } else if (error != null && error.getCause() instanceof GlPostingException g) {
+            fillFromError(f, g);
+            f.setError(truncate(messageChain(error)));
+            f.setStackHead(stackHead(error));
+            return;
+        }
+        f.setError(truncate(messageChain(error)));
+        f.setStackHead(stackHead(error));
+    }
+
+    static String messageChain(Throwable error) {
+        if (error == null) return null;
+        StringBuilder sb = new StringBuilder();
+        Throwable t = error;
+        int depth = 0;
+        while (t != null && depth++ < 5) {
+            if (!sb.isEmpty()) sb.append(" <- ");
+            sb.append(t.getClass().getSimpleName()).append(": ").append(t.getMessage());
+            if (t.getCause() == t) break;
+            t = t.getCause();
+        }
+        return sb.toString();
+    }
+
+    private static String stackHead(Throwable error) {
+        if (error == null) return null;
+        Throwable root = error;
+        while (root.getCause() != null && root.getCause() != root) root = root.getCause();
+        StringBuilder sb = new StringBuilder(root.getClass().getName());
+        StackTraceElement[] st = root.getStackTrace();
+        for (int i = 0; i < Math.min(8, st.length); i++) sb.append("\n  at ").append(st[i]);
+        return truncate(sb.toString());
+    }
+
+    private static String truncate(String s) {
+        return s == null || s.length() <= MAX_ERROR ? s : s.substring(0, MAX_ERROR);
+    }
+
+    private static String writeLines(List<PostingEngine.JournalLine> lines) {
+        try {
+            return lines == null || lines.isEmpty() ? null : JSON.writeValueAsString(lines);
+        } catch (Exception e) {
+            return null;
+        }
+    }
+
+    static List<PostingEngine.JournalLine> readLines(String json) {
+        if (json == null || json.isBlank()) return List.of();
+        try {
+            return JSON.readValue(json, new TypeReference<List<PostingEngine.JournalLine>>() {});
+        } catch (Exception e) {
+            throw new IllegalStateException("lines_json haisomeki: " + e.getMessage(), e);
+        }
+    }
+}
