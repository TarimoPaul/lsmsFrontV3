new file mode 100644
index 0000000..fb3e063
--- /dev/null
+++ b/src/test/java/com/Lsms/CapitalAndExpenditure/gl/GlConcurrentPostCheck.java
@@ -0,0 +1,116 @@
+package com.Lsms.CapitalAndExpenditure.gl;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfSystemProperty;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.transaction.support.TransactionTemplate;
+
+import java.math.BigDecimal;
+import java.time.LocalDate;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.UUID;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.CyclicBarrier;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.Future;
+import java.util.concurrent.TimeUnit;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * Two posts of the same reference at the same moment leave ONE journal (the advisory
+ * lock in PostingEngine.executePost). Needs a real PostgreSQL, so it is NOT part of the
+ * build; run it against a THROW-AWAY copy (it writes journals tagged QA-LOCK-):
+ *   mvnw -o test -Dtest=GlConcurrentPostCheck -Dgl.lock.check=true \
+ *        -Dspring.datasource.url=jdbc:postgresql://localhost:5432/lsms_lockcheck
+ */
+@SpringBootTest
+@EnabledIfSystemProperty(named = "gl.lock.check", matches = "true")
+class GlConcurrentPostCheck {
+
+    private static final int ROUNDS = 25;
+
+    @Autowired
+    private PostingEngine postingEngine;
+    @Autowired
+    private JdbcTemplate jdbc;
+    @Autowired
+    private TransactionTemplate tx;
+
+    private void postOnce(String ref) {
+        try (AutoCloseable ignored = postingEngine.withThrowOnError()) {
+            postingEngine.post(JournalEventType.CAPITAL_INJECTION, ref, ref, LocalDate.now(), null, "QA-LOCK",
+                    List.of(new PostingEngine.JournalLine("1000", BigDecimal.ONE, BigDecimal.ZERO, "QA lock"),
+                            new PostingEngine.JournalLine("3000", BigDecimal.ZERO, BigDecimal.ONE, "QA lock")));
+        } catch (RuntimeException e) {
+            throw e;
+        } catch (Exception e) {
+            throw new IllegalStateException(e);
+        }
+    }
+
+    private int journals(String ref) {
+        Integer n = jdbc.queryForObject(
+                "SELECT count(*) FROM journal_entry WHERE reference_uid = ? AND NOT is_reversal", Integer.class, ref);
+        return n != null ? n : -1;
+    }
+
+    @Test
+    void twoSimultaneousPostsLeaveOneJournal() throws Exception {
+        ExecutorService pool = Executors.newFixedThreadPool(2);
+        List<String> doubles = new ArrayList<>();
+        try {
+            for (int round = 0; round < ROUNDS; round++) {
+                String ref = "QA-LOCK-" + UUID.randomUUID();
+                CyclicBarrier start = new CyclicBarrier(2);
+                List<Future<?>> fs = new ArrayList<>();
+                for (int t = 0; t < 2; t++) {
+                    fs.add(pool.submit(() -> {
+                        start.await(10, TimeUnit.SECONDS);
+                        postOnce(ref);
+                        return null;
+                    }));
+                }
+                for (Future<?> f : fs) f.get(30, TimeUnit.SECONDS);
+                int n = journals(ref);
+                System.out.println("LOCKCHECK round " + round + " " + ref + " journals=" + n);
+                if (n != 1) doubles.add(ref + "=" + n);
+            }
+        } finally {
+            pool.shutdownNow();
+        }
+        assertThat(doubles).as("references with != 1 journal after 2 simultaneous posts").isEmpty();
+    }
+
+    @Test
+    void postWaitsForTheLockHolder() throws Exception {
+        String ref = "QA-LOCK-" + UUID.randomUUID();
+        CountDownLatch held = new CountDownLatch(1);
+        ExecutorService pool = Executors.newSingleThreadExecutor();
+        try {
+            Future<?> holder = pool.submit(() -> tx.executeWithoutResult(s -> {
+                jdbc.queryForObject("SELECT 1 FROM (SELECT pg_advisory_xact_lock(hashtext(?))) l", Integer.class, ref);
+                held.countDown();
+                try {
+                    Thread.sleep(2000);
+                } catch (InterruptedException e) {
+                    Thread.currentThread().interrupt();
+                }
+            }));
+            assertThat(held.await(10, TimeUnit.SECONDS)).isTrue();
+            long t0 = System.nanoTime();
+            postOnce(ref);
+            long waitedMs = (System.nanoTime() - t0) / 1_000_000;
+            holder.get(10, TimeUnit.SECONDS);
+            System.out.println("LOCKCHECK post waited " + waitedMs + " ms for the lock holder");
+            assertThat(waitedMs).isGreaterThanOrEqualTo(1500);
+            assertThat(journals(ref)).isEqualTo(1);
+        } finally {
+            pool.shutdownNow();
+        }
+    }
+}
