diff --git a/src/main/resources/db/migration/V134__Gl_Posting_Failure_And_Period_Close.sql b/src/main/resources/db/migration/V134__Gl_Posting_Failure_And_Period_Close.sql
new file mode 100644
index 0000000..a72be41
--- /dev/null
+++ b/src/main/resources/db/migration/V134__Gl_Posting_Failure_And_Period_Close.sql
@@ -0,0 +1,93 @@
+-- V134 (Toleo 1, MPANGO-PAMOJA §1.4 + §1.9). Additive only: no existing row is changed.
+--
+-- 1. gl_posting_failure: every GL posting that a business flow catches and continues
+--    without (sale, payment, purchase, supplier payment, walk-in debt, day close,
+--    stock adjustment, shrinkage, counting) now leaves a row here instead of a log line
+--    only. Retry re-posts it; resolved_at is set once the reference has a live journal.
+-- 2. daily_financial_snapshot.variance_kind: SHORTAGE / SURPLUS / OVER_DEDUCTION.
+--    OVER_DEDUCTION = variance < 0 with nothing counted (declared 0): deductions
+--    exceeded the day's sales, no money was found, so nothing is posted.
+--    daily_financial_snapshot.variance_target: '2900' / '6700' / NULL (see below).
+-- 3. Period closing: journal_entry.event_date + is_late_entry (an event dated inside a
+--    CLOSED period is booked on the first open day and keeps its real date here),
+--    gl_period.closed_by_uid / checks_json, and gl_period_audit (who closed/reopened, why).
+
+CREATE TABLE IF NOT EXISTS gl_posting_failure (
+    id               BIGSERIAL PRIMARY KEY,
+    uid              VARCHAR(36)  NOT NULL UNIQUE,
+    source_type      VARCHAR(40)  NOT NULL,
+    source_uid       VARCHAR(255) NOT NULL,
+    source_number    VARCHAR(100),
+    event_type       VARCHAR(50),
+    reference_uid    VARCHAR(96),
+    entry_date       DATE,
+    branch_uid       VARCHAR(255),
+    posted_by        VARCHAR(255),
+    lines_json       TEXT,
+    error            TEXT,
+    stack_head       TEXT,
+    attempts         INTEGER      NOT NULL DEFAULT 1,
+    last_attempt_at  TIMESTAMP    NOT NULL DEFAULT NOW(),
+    resolved_at      TIMESTAMP,
+    resolved_by_uid  VARCHAR(255),
+    resolution       VARCHAR(255),
+    created_at       TIMESTAMP    NOT NULL DEFAULT NOW()
+);
+
+CREATE INDEX IF NOT EXISTS idx_gl_posting_failure_open
+    ON gl_posting_failure (created_at) WHERE resolved_at IS NULL;
+CREATE INDEX IF NOT EXISTS idx_gl_posting_failure_source
+    ON gl_posting_failure (source_type, source_uid);
+
+ALTER TABLE daily_financial_snapshot
+    ADD COLUMN IF NOT EXISTS variance_kind VARCHAR(20);
+
+-- Where a day's SURPLUS is credited: '2900' Suspense until the owner decides where the
+-- money came from (RIPOTI Q9), else NULL / '6700'. Kept on the snapshot so a retry,
+-- a later correction run and the next version after a reopen all post to the same
+-- account; set by the day-close correction for the snapshots the owner names.
+ALTER TABLE daily_financial_snapshot
+    ADD COLUMN IF NOT EXISTS variance_target VARCHAR(10);
+
+ALTER TABLE daily_financial_snapshot
+    DROP CONSTRAINT IF EXISTS chk_dfs_variance_target;
+ALTER TABLE daily_financial_snapshot
+    ADD CONSTRAINT chk_dfs_variance_target CHECK (variance_target IS NULL OR variance_target IN ('6700', '2900'));
+
+ALTER TABLE journal_entry
+    ADD COLUMN IF NOT EXISTS event_date DATE,
+    ADD COLUMN IF NOT EXISTS is_late_entry BOOLEAN NOT NULL DEFAULT FALSE;
+
+ALTER TABLE gl_period
+    ADD COLUMN IF NOT EXISTS closed_by_uid VARCHAR(255),
+    ADD COLUMN IF NOT EXISTS checks_json   TEXT;
+
+-- Periods are business-wide (branch_uid NULL). The V071 unique key treats NULLs as
+-- distinct, so it never stopped two rows for the same month.
+CREATE UNIQUE INDEX IF NOT EXISTS uq_gl_period_month_global
+    ON gl_period (period_year, period_month) WHERE branch_uid IS NULL;
+
+CREATE TABLE IF NOT EXISTS gl_period_audit (
+    id            BIGSERIAL PRIMARY KEY,
+    uid           VARCHAR(36)  NOT NULL UNIQUE,
+    period_year   INTEGER      NOT NULL,
+    period_month  INTEGER      NOT NULL,
+    action        VARCHAR(10)  NOT NULL,
+    reason        TEXT,
+    by_uid        VARCHAR(255),
+    by_name       VARCHAR(255),
+    at            TIMESTAMP    NOT NULL DEFAULT NOW(),
+    CONSTRAINT chk_gl_period_audit_action CHECK (action IN ('CLOSE', 'REOPEN'))
+);
+
+CREATE INDEX IF NOT EXISTS idx_gl_period_audit_month
+    ON gl_period_audit (period_year, period_month);
+
+-- 4. 2900 Suspense (planned for V135, brought forward): the day-close correction can
+--    post a surplus whose source the owner has not decided (RIPOTI Q9) as
+--    Dr 1000 / Cr 2900 instead of Cr 6700. ON CONFLICT keeps a later seed harmless.
+INSERT INTO gl_account
+    (uid, account_code, account_name, account_name_sw, account_type, account_category, normal_balance, is_active, is_system, sort_order)
+VALUES
+    (gen_random_uuid(), '2900', 'Suspense', 'Pesa Inayosubiri Uamuzi', 'LIABILITY', 'CURRENT_LIABILITY', 'CREDIT', true, true, 2900)
+ON CONFLICT (account_code) DO NOTHING;
