+    public Response<DayCloseVarianceService.CorrectionResult> correctDayCloseVariance(
+            @RequestParam(defaultValue = "true") boolean dryRun,
+            @RequestParam(required = false) List<String> suspenseSnapshotUid) {
+        try {
+            String by = com.Lsms.uaa.utils.LoggedUser.getUid();
+            java.util.Set<String> suspense = suspenseSnapshotUid != null
+                    ? new java.util.HashSet<>(suspenseSnapshotUid) : java.util.Set.of();
+            log.warn("Day-close variance correction requested by {} (dryRun={}, to 2900: {})", by, dryRun, suspense);
+            DayCloseVarianceService.CorrectionResult r = dayCloseVarianceService.correct(dryRun, by, suspense);
+            return new Response<>(r.getErrors() == 0 ? ResponseStatus.Success : ResponseStatus.Warning, r,
+                    dryRun ? "Hakiki tu: hakuna kilichoandikwa" : "Marekebisho: " + r.getDone() + " / " + r.getToChange());
+        } catch (IllegalStateException e) {
+            return new Response<>(ResponseStatus.Error, null, e.getMessage());
+        }
+    }
+
+    @Operation(summary = "GL months and their status")
+    @GetMapping("/periods")
+    @PreAuthorize("hasPermission(null, 'FINANCE_READ')")
+    public Response<List<java.util.Map<String, Object>>> periods() {
+        return new Response<>(glPeriodService.list());
+    }
+
+    @Operation(summary = "Close / reopen history of GL months")
+    @GetMapping("/periods/audit")
+    @PreAuthorize("hasPermission(null, 'FINANCE_READ')")
+    public Response<List<GlPeriodAudit>> periodAudit(@RequestParam(required = false) Integer year,
