+package com.Lsms.CapitalAndExpenditure.gl;
+
+import com.Lsms.Reconciliation.Entity.DailyFinancialSnapshot;
+import com.Lsms.Reconciliation.Entity.DailyReconciliation;
+import com.Lsms.Reconciliation.Enums.ReconciliationStatus;
+import com.Lsms.Reconciliation.Repository.DailyFinancialSnapshotRepository;
+import com.Lsms.Reconciliation.Repository.DailyReconciliationRepository;
+import lombok.Builder;
+import lombok.Data;
+import lombok.RequiredArgsConstructor;
+import lombok.extern.slf4j.Slf4j;
+import org.springframework.stereotype.Service;
+
+import java.math.BigDecimal;
+import java.time.LocalDate;
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.TreeMap;
+
+/**
+ * Day-close variance in the GL (MPANGO-PAMOJA §1.2, §1.3):
+ *  - {@link #postForApproval}: the approval hook — posts the current snapshot with the
+ *    corrected rule, stamps its variance_kind, and records a failure instead of losing it;
+ *  - {@link #reverseFor}: a superseded or reopened snapshot gives its journal back,
+ *    dated like the original (RIPOTI H-5: re-approval used to post the variance twice);
+ *  - {@link #correct}: the one-off data fix of the journals posted with the old,
+ *    inverted sign (RIPOTI H-1), with a dry run that writes nothing.
+ *
+ * Only an APPROVED reconciliation's current snapshot is ever posted: a reopened day
+ * has had its journal reversed and gets a new snapshot when it is approved again.
+ * A snapshot's {@code variance_target} ('2900') keeps the owner's suspense decision
+ * (RIPOTI Q9) on the snapshot itself, so every later post (approval, retry,
+ * correction, and the next version after a reopen) goes to the same account.
+ */
+@Service
+@RequiredArgsConstructor
+@Slf4j
+public class DayCloseVarianceService {
+
+    private final PostingEngine postingEngine;
+    private final DailyFinancialSnapshotRepository snapshotRepository;
+    private final JournalEntryRepository journalEntryRepository;
+    private final JournalEntryLineRepository journalEntryLineRepository;
+    private final GlPostingFailureService failureService;
+    private final GlConfigService glConfigService;
+    private final DailyReconciliationRepository reconciliationRepository;
+
+    private static final String CASH = "1000";
+    public static final String SOURCE_CORRECTION = "DAY_CLOSE_CORRECTION";
+    private static final String TYPE = JournalEventType.DAY_CLOSE_VARIANCE.name();
+
+    /** The snapshot's surplus belongs in 2900 Suspense (variance_target = '2900'). */
+    public static boolean toSuspense(DailyFinancialSnapshot snap) {
+        return snap != null && PostingEngine.SUSPENSE.equals(snap.getVarianceTarget());
+    }
+
+    /**
+     * Approval hook. Sets {@code snapshot.varianceKind} on the caller's (managed)
+     * entity and posts. Never throws: a failed post is kept in gl_posting_failure.
+     */
+    public PostingEngine.DayCloseVariance postForApproval(DailyFinancialSnapshot snapshot, String postedBy) {
+        if (snapshot == null) return null;
+        PostingEngine.DayCloseVariance v = PostingEngine.classifyDayCloseVariance(snapshot);
+        snapshot.setVarianceKind(v != null ? v.kind().name() : null);
+        try (AutoCloseable ignored = postingEngine.withThrowOnError()) {
+            postingEngine.postDayCloseVariance(snapshot, postedBy, toSuspense(snapshot));
+        } catch (Exception e) {
+            log.error("GL postDayCloseVariance failed for snapshot {}: {}", snapshot.getUid(),
+                    GlPostingFailureService.messageChain(e));
+            failureService.record(GlPostingFailureService.SOURCE_DAY_CLOSE, snapshot.getUid(),
+                    snapshot.getReconciliationUid(), e);
+        }
+        return v;
+    }
+
+    /**
+     * Retry path: re-posts the CURRENT snapshot by uid; throws on a failed post.
+     * Posts nothing when the snapshot was superseded, its reconciliation is not
+     * APPROVED (reopened), or a live unreversed DAY_CLOSE_VARIANCE journal already
+     * exists for it, so a retry run twice still leaves one journal.
+     */
+    public GlPostOutcome postCurrent(String snapshotUid, String postedBy) {
+        DailyFinancialSnapshot snap = snapshotRepository.findByUid(snapshotUid)
+                .orElseThrow(() -> new IllegalStateException("Snapshot haipo: " + snapshotUid));
+        if (!Boolean.TRUE.equals(snap.getIsCurrent())) {
+            log.info("Day close {} is superseded - not posted", snapshotUid);
+            return GlPostOutcome.SUPERSEDED;
+        }
+        if (!isApproved(snap)) {
+            log.info("Day close {}: reconciliation {} is not APPROVED - not posted", snapshotUid, snap.getReconciliationUid());
+            return GlPostOutcome.NOT_APPROVED;
+        }
+        if (postingEngine.hasActivePosting(TYPE, snapshotUid)) {
+            log.info("Day close {} already has a live journal - not posted again", snapshotUid);
+            failureService.resolveBySource(snapshotUid, postedBy, GlPostOutcome.ALREADY_POSTED.name());
+            return GlPostOutcome.ALREADY_POSTED;
+        }
+        PostingEngine.DayCloseVariance v;
+        try (AutoCloseable ignored = postingEngine.withThrowOnError()) {
+            v = postingEngine.postDayCloseVariance(snap, postedBy, toSuspense(snap));
+        } catch (RuntimeException e) {
+            throw e;
+        } catch (Exception e) {
+            throw new IllegalStateException(e.getMessage(), e);
+        }
+        snap.setVarianceKind(v != null ? v.kind().name() : null);
+        snapshotRepository.save(snap);
+        return v == null || v.postedAmount().signum() <= 0 ? GlPostOutcome.NOTHING_TO_POST : GlPostOutcome.POSTED;
+    }
+
+    /** True when the snapshot's reconciliation is APPROVED now (not reopened / resubmitted). */
+    private boolean isApproved(DailyFinancialSnapshot snap) {
+        if (snap.getReconciliationUid() == null) return false;
+        return reconciliationRepository.findByUid(snap.getReconciliationUid())
+                .map(DailyReconciliation::getStatus)
+                .filter(st -> st == ReconciliationStatus.APPROVED)
+                .isPresent();
+    }
+
+    /**
+     * Reverses every live journal of a snapshot (reopen / supersede), on the original
+     * date. Never throws; a failure is recorded so the double posting can be fixed.
+     */
+    public void reverseFor(String snapshotUid, String postedBy, String reason) {
+        if (snapshotUid == null) return;
+        try (AutoCloseable ignored = postingEngine.withThrowOnError()) {
+            postingEngine.reverseActiveByReference(snapshotUid, postedBy, reason, true);
+        } catch (Exception e) {
+            log.error("GL reversal of day close {} failed: {}", snapshotUid, GlPostingFailureService.messageChain(e));
+            failureService.record("DAY_CLOSE_REVERSAL", snapshotUid, null, e);
+        }
+    }
+
+    // ── One-off correction (H-1 + H-5) ───────────────────────────────────────
+
+    @Data
+    @Builder
+    public static class CorrectionRow {
+        private String snapshotUid;
+        private String journalUid;
+        private String journalNumber;
+        private LocalDate date;
+        private String userName;
+        private Integer snapshotVersion;
+        private Boolean current;
+        private BigDecimal variance;
+        private BigDecimal declared;
+        /** SHORTAGE / SURPLUS / OVER_DEDUCTION / SUPERSEDED / ZERO. */
+        private String group;
+        /** REVERSE_AND_REPOST / REVERSE_ONLY / POST_MISSING / ALREADY_CORRECT. */
+        private String action;
+        /** Effect on account 1000 (Dr − Cr) of the live journal now, and after the fix. */
+        private BigDecimal cashBefore;
+        private BigDecimal cashAfter;
+        private BigDecimal overDeducted;
+        /** The non-cash account of the live journal now, and after the fix (6700 / 2900; null = none). */
+        private String counterBefore;
+        private String counterAfter;
+        private String error;
+    }
+
+    @Data
+    @Builder
+    public static class CorrectionResult {
+        private boolean dryRun;
+        private int journals;
+        private int toChange;
+        private int done;
+        private int errors;
+        /** Per group: count and TZS of the variance. */
+        private Map<String, BigDecimal[]> groups;
+        private BigDecimal cashBefore;
+        private BigDecimal cashAfter;
+        /** cashAfter − cashBefore: what account 1000 moves by (6700 moves the opposite way). */
+        private BigDecimal cashChange;
+        /** What goes to 2900 Suspense instead of 6700 (the snapshots named in the request). */
+        private BigDecimal suspenseAmount;
+        /** Requested suspense snapshots that are not a current SURPLUS row; a real run refuses them. */
+        private List<String> suspenseNotApplicable;
+        private List<CorrectionRow> rows;
+    }
+
+    /**
+     * Finds every live DAY_CLOSE_VARIANCE journal and every current snapshot with a
+     * variance, and brings each to the corrected rule:
+     *  - current snapshot, journal differs from the rule: reverse (on the original
+     *    date) and repost; OVER_DEDUCTION: reverse only, nothing reposted;
+     *  - superseded snapshot that still has a live journal (H-5): reverse only;
+     *  - current snapshot with a variance and no live journal: post it, only when
+     *    its reconciliation is APPROVED;
+     *  - current snapshot of a reconciliation that is not APPROVED (reopened) that
+     *    still has a live journal: reverse only (group NOT_APPROVED), as reopen does;
+     *  - journal already as the rule says: left alone, so a second run changes nothing.
+     * With {@code dryRun} nothing is written; the rows show what would happen.
+     */
+    public CorrectionResult correct(boolean dryRun, String by) {
+        return correct(dryRun, by, Set.of());
+    }
+
+    /**
+     * As above; the SURPLUS of each snapshot in {@code suspenseSnapshotUids} is posted
+     * Dr 1000 / Cr 2900 instead of Cr 6700, until the owner decides where that money
+     * came from (RIPOTI Q9: 24/06 and 04/07). Account 1000 moves the same either way.
+     * A real run refuses a uid that is not a current SURPLUS, so a typo never passes
+     * silently; a dry run lists it in {@code suspenseNotApplicable}.
+     *
+     * A real run writes variance_target = '2900' on those snapshots, and every run
+     * also treats a snapshot that already carries it as named, so the choice survives
+     * later runs, retries and re-approval. A row that fails is kept in
+     * gl_posting_failure (source DAY_CLOSE_CORRECTION); a row that succeeds resolves
+     * the snapshot's open failures.
+     */
+    public CorrectionResult correct(boolean dryRun, String by, Set<String> suspenseSnapshotUids) {
+        if (!glConfigService.isPostingEnabled()) {
+            throw new IllegalStateException("GL posting imezimwa.");
+        }
+        Set<String> requested = suspenseSnapshotUids != null ? suspenseSnapshotUids : Set.of();
+        Set<String> suspense = new HashSet<>(requested);
+        String reason = "Marekebisho ya H-1/H-5: alama ya variance ya kufunga siku";
+        List<CorrectionRow> rows = new ArrayList<>();
+        Set<String> snapshotsWithJournal = new HashSet<>();
+
+        for (JournalEntry j : journalEntryRepository
+                .findByReferenceTypeAndIsReversalFalseAndIsDeletedFalseOrderByEntryDateAscIdAsc(
+                        JournalEventType.DAY_CLOSE_VARIANCE.name())) {
+            if (journalEntryRepository.existsByReversedEntryUidAndIsDeletedFalse(j.getUid())) continue;
+            DailyFinancialSnapshot snap = snapshotRepository.findByUid(j.getReferenceUid()).orElse(null);
+            List<JournalEntryLine> jl = journalEntryLineRepository.findByJournalEntryUid(j.getUid());
+            BigDecimal before = cashEffect(jl);
+            String counterBefore = counterAccount(jl);
+            CorrectionRow.CorrectionRowBuilder row = CorrectionRow.builder()
+                    .snapshotUid(j.getReferenceUid()).journalUid(j.getUid()).journalNumber(j.getEntryNumber())
+                    .date(j.getEntryDate()).cashBefore(before).counterBefore(counterBefore);
+            if (snap == null) {
+                // Not a case seen in the data; never touched without a person looking at it.
+                rows.add(row.group("ORPHAN").action("NONE").cashAfter(before).counterAfter(counterBefore)
+                        .overDeducted(BigDecimal.ZERO).build());
+                continue;
+            }
+            row.userName(snap.getUserName()).snapshotVersion(snap.getSnapshotVersion())
+                    .current(Boolean.TRUE.equals(snap.getIsCurrent()))
+                    .variance(snap.getVarianceAmount()).declared(snap.getDeclaredCash()).date(snap.getSnapshotDate());
+            if (!Boolean.TRUE.equals(snap.getIsCurrent())) {
+                rows.add(row.group("SUPERSEDED").action("REVERSE_ONLY").cashAfter(BigDecimal.ZERO)
+                        .overDeducted(BigDecimal.ZERO).build());
+                continue;
+            }
+            snapshotsWithJournal.add(snap.getUid());
+            if (toSuspense(snap)) suspense.add(snap.getUid());
+            if (!isApproved(snap)) {
+                // Reopened: its money is not known until it is approved again (reopen()
+                // reverses the journal now; this catches one reopened before that).
+                rows.add(row.group("NOT_APPROVED").action("REVERSE_ONLY").cashAfter(BigDecimal.ZERO)
+                        .overDeducted(BigDecimal.ZERO).build());
+                continue;
+            }
+            PostingEngine.DayCloseVariance v = PostingEngine.classifyDayCloseVariance(snap);
+            BigDecimal after = cashEffect(v);
+            String counterAfter = counterAccount(v, suspense.contains(snap.getUid()));
+            String group = v == null ? "ZERO" : v.kind().name();
+            String action;
+            if (after.compareTo(before) == 0 && java.util.Objects.equals(counterAfter, counterBefore)) action = "ALREADY_CORRECT";
+            else if (after.signum() == 0) action = "REVERSE_ONLY";
+            else action = "REVERSE_AND_REPOST";
+            rows.add(row.group(group).action(action).cashAfter(after).counterAfter(counterAfter)
+                    .overDeducted(v != null ? v.overDeducted() : BigDecimal.ZERO).build());
+        }
+
+        for (DailyFinancialSnapshot snap : snapshotRepository.findAll()) {
+            if (!Boolean.TRUE.equals(snap.getIsCurrent()) || snapshotsWithJournal.contains(snap.getUid())) continue;
+            PostingEngine.DayCloseVariance v = PostingEngine.classifyDayCloseVariance(snap);
+            if (v == null || v.postedAmount().signum() <= 0) continue;
+            if (!isApproved(snap)) continue; // reopened: posted again on re-approval
+            if (toSuspense(snap)) suspense.add(snap.getUid());
+            rows.add(CorrectionRow.builder().snapshotUid(snap.getUid()).date(snap.getSnapshotDate())
+                    .userName(snap.getUserName()).snapshotVersion(snap.getSnapshotVersion()).current(true)
+                    .variance(snap.getVarianceAmount()).declared(snap.getDeclaredCash())
+                    .group(v.kind().name()).action("POST_MISSING").cashBefore(BigDecimal.ZERO)
+                    .cashAfter(cashEffect(v)).counterAfter(counterAccount(v, suspense.contains(snap.getUid())))
+                    .overDeducted(v.overDeducted()).build());
+        }
+
+        Set<String> applicable = new HashSet<>();
+        BigDecimal suspenseAmount = BigDecimal.ZERO;
+        for (CorrectionRow r : rows) {
+            if (PostingEngine.SUSPENSE.equals(r.getCounterAfter())) {
+                applicable.add(r.getSnapshotUid());
+                suspenseAmount = suspenseAmount.add(nz(r.getCashAfter()));
+            }
+        }
+        List<String> notApplicable = requested.stream().filter(u -> !applicable.contains(u)).sorted().toList();
+        if (!dryRun && !notApplicable.isEmpty()) {
+            throw new IllegalStateException("Snapshot hizi si ziada (SURPLUS) hai, haziwezi kwenda 2900: " + notApplicable);
+        }
+        if (!dryRun) {
+            // The owner's decision is kept on the snapshot before anything is posted.
+            for (String uid : applicable) {
+                snapshotRepository.findByUid(uid).ifPresent(snap -> {
+                    if (!toSuspense(snap)) {
+                        snap.setVarianceTarget(PostingEngine.SUSPENSE);
+                        snapshotRepository.save(snap);
+                    }
+                });
+            }
+        }
+
+        int done = 0, errors = 0, toChange = 0;
+        for (CorrectionRow r : rows) {
+            if ("ALREADY_CORRECT".equals(r.getAction()) || "NONE".equals(r.getAction())) continue;
+            toChange++;
+            if (dryRun) continue;
+            try (AutoCloseable ignored = postingEngine.withThrowOnError()) {
+                if (r.getJournalUid() != null) {
+                    JournalEntry j = journalEntryRepository.findByUid(r.getJournalUid()).orElseThrow();
+                    LocalDate original = j.getEventDate() != null ? j.getEventDate() : j.getEntryDate();
+                    postingEngine.reverse(r.getJournalUid(), by, reason, original);
+                }
+                if (Boolean.TRUE.equals(r.getCurrent()) && !"NOT_APPROVED".equals(r.getGroup())) {
+                    DailyFinancialSnapshot snap = snapshotRepository.findByUid(r.getSnapshotUid()).orElseThrow();
+                    PostingEngine.DayCloseVariance v = postingEngine.postDayCloseVariance(snap, by,
+                            PostingEngine.SUSPENSE.equals(r.getCounterAfter()));
+                    snap.setVarianceKind(v != null ? v.kind().name() : null);
+                    snapshotRepository.save(snap);
+                }
+                done++;
+                failureService.resolveBySource(r.getSnapshotUid(), by, "CORRECTED");
+            } catch (Exception e) {
+                errors++;
+                r.setError(GlPostingFailureService.messageChain(e));
+                log.error("Day-close correction of snapshot {} failed: {}", r.getSnapshotUid(), r.getError());
+                failureService.record(SOURCE_CORRECTION, r.getSnapshotUid(), r.getJournalNumber(), e);
+            }
+        }
+
+        Map<String, BigDecimal[]> groups = new TreeMap<>();
+        BigDecimal cashBefore = BigDecimal.ZERO, cashAfter = BigDecimal.ZERO;
+        for (CorrectionRow r : rows) {
+            BigDecimal[] g = groups.computeIfAbsent(r.getGroup(), k -> new BigDecimal[]{BigDecimal.ZERO, BigDecimal.ZERO});
+            g[0] = g[0].add(BigDecimal.ONE);
+            g[1] = g[1].add(r.getVariance() != null ? r.getVariance().abs() : BigDecimal.ZERO);
+            cashBefore = cashBefore.add(nz(r.getCashBefore()));
+            cashAfter = cashAfter.add(nz(r.getCashAfter()));
+        }
+        log.info("Day-close variance correction (dryRun={}) by {}: {} rows, {} to change, {} done, {} errors, {} to 2900 {}",
+                dryRun, by, rows.size(), toChange, done, errors, suspenseAmount, applicable);
+        return CorrectionResult.builder().dryRun(dryRun).journals(rows.size()).toChange(toChange)
+                .done(done).errors(errors).groups(groups).cashBefore(cashBefore).cashAfter(cashAfter)
+                .cashChange(cashAfter.subtract(cashBefore)).suspenseAmount(suspenseAmount)
+                .suspenseNotApplicable(notApplicable).rows(rows).build();
+    }
+
+    /** Dr − Cr on account 1000 of one journal's lines. */
+    private static BigDecimal cashEffect(List<JournalEntryLine> lines) {
+        BigDecimal e = BigDecimal.ZERO;
+        for (JournalEntryLine l : lines) {
+            if (CASH.equals(l.getAccountCode())) e = e.add(nz(l.getDebitAmount())).subtract(nz(l.getCreditAmount()));
+        }
+        return e;
+    }
+
+    /** The first non-cash account of a journal (a variance journal has exactly one). */
+    private static String counterAccount(List<JournalEntryLine> lines) {
+        for (JournalEntryLine l : lines) {
+            if (!CASH.equals(l.getAccountCode())) return l.getAccountCode();
+        }
+        return null;
+    }
+
+    /** The non-cash account the corrected rule posts to. */
+    private static String counterAccount(PostingEngine.DayCloseVariance v, boolean toSuspense) {
+        if (v == null || v.postedAmount().signum() <= 0) return null;
+        return v.kind() == PostingEngine.VarianceKind.SURPLUS && toSuspense ? PostingEngine.SUSPENSE : "6700";
+    }
+
+    /** Dr − Cr on account 1000 the corrected rule posts. */
+    private static BigDecimal cashEffect(PostingEngine.DayCloseVariance v) {
+        if (v == null || v.postedAmount().signum() <= 0) return BigDecimal.ZERO;
+        return v.kind() == PostingEngine.VarianceKind.SHORTAGE ? v.postedAmount().negate() : v.postedAmount();
+    }
+
+    private static BigDecimal nz(BigDecimal v) {
+        return v != null ? v : BigDecimal.ZERO;
+    }
+}
