+++ b/src/main/java/com/Lsms/CapitalAndExpenditure/gl/GlPostingFailure.java
@@ -0,0 +1,93 @@
+package com.Lsms.CapitalAndExpenditure.gl;
+
+import jakarta.persistence.*;
+import lombok.Data;
+import lombok.NoArgsConstructor;
+
+import java.time.LocalDate;
+import java.time.LocalDateTime;
+import java.util.UUID;
+
+/**
+ * A GL posting that failed while the business event itself was kept (V134). Before
+ * this table such failures were only a log line, so a credit sale could live for days
+ * with no journal (RIPOTI H-2). Open rows (resolved_at IS NULL) are shown on the GL
+ * overview and can be retried.
+ */
+@Entity
+@Table(name = "gl_posting_failure")
+@Data
+@NoArgsConstructor
+public class GlPostingFailure {
+
+    @Id
+    @GeneratedValue(strategy = GenerationType.IDENTITY)
+    private Long id;
+
+    @Column(name = "uid", unique = true, nullable = false, updatable = false, length = 36)
+    private String uid;
+
+    /** What the failed posting was for: SALE, PAYMENT_RECEIVED, PURCHASE, DAY_CLOSE, ... */
+    @Column(name = "source_type", nullable = false, length = 40)
+    private String sourceType;
+
+    @Column(name = "source_uid", nullable = false)
+    private String sourceUid;
+
+    /** Receipt / reference number people recognise, when known. */
+    @Column(name = "source_number", length = 100)
+    private String sourceNumber;
+
+    /** The journal event type, when the failure happened inside PostingEngine.post. */
+    @Column(name = "event_type", length = 50)
+    private String eventType;
+
+    /** The journal reference_uid the posting used (may differ from source_uid, e.g. "<uid>:DEBT"). */
+    @Column(name = "reference_uid", length = 96)
+    private String referenceUid;
+
+    @Column(name = "entry_date")
+    private LocalDate entryDate;
+
+    @Column(name = "branch_uid")
+    private String branchUid;
+
+    @Column(name = "posted_by")
+    private String postedBy;
+
+    /** The journal lines that were attempted (JSON), so a retry can replay them. */
+    @Column(name = "lines_json", columnDefinition = "TEXT")
+    private String linesJson;
+
+    @Column(name = "error", columnDefinition = "TEXT")
+    private String error;
+
+    @Column(name = "stack_head", columnDefinition = "TEXT")
+    private String stackHead;
+
+    @Column(name = "attempts", nullable = false)
+    private Integer attempts = 1;
+
+    @Column(name = "last_attempt_at", nullable = false)
+    private LocalDateTime lastAttemptAt;
+
+    @Column(name = "resolved_at")
+    private LocalDateTime resolvedAt;
+
