@@ -0,0 +1,18 @@
+package com.Lsms.CapitalAndExpenditure.gl;
+
+/**
+ * What a re-post from the source record did (sale repost, day-close retry). Every
+ * outcome except an exception leaves nothing for a retry to do.
+ */
+public enum GlPostOutcome {
+    /** A journal was posted now. */
+    POSTED,
+    /** A live, unreversed journal of this event type already existed; nothing was posted. */
+    ALREADY_POSTED,
+    /** The source needs no journal (walk-in debt, zero / over-deduction variance). */
+    NOTHING_TO_POST,
+    /** Day close only: the reconciliation is not APPROVED (reopened); re-approval posts a new snapshot. */
+    NOT_APPROVED,
+    /** Day close only: the snapshot was replaced by a newer version, which carries the posting. */
+    SUPERSEDED
+}
