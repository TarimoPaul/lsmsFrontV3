+            assertThat(dry.getRows()).extracting(JournalRedateService.Row::getStatus).containsExactly("OK", "INVALID");
+            org.assertj.core.api.Assertions.assertThatThrownBy(() -> service.redate(List.of("j1", "j2"), sep30, NOTE, false, "boss"))
