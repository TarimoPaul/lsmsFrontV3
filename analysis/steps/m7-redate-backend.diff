+            assertThat(posted.getValue()).extracting(PostingEngine.JournalLine::accountCode).containsExactly("2000", "1000");
+            assertThat(posted.getValue().get(0).debit()).isEqualByComparingTo("6258126.33");
+            assertThat(posted.getValue().get(1).credit()).isEqualByComparingTo("6258126.33");
