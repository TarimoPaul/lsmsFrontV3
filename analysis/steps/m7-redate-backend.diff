+            JournalEntryLine ap = new JournalEntryLine();
+            ap.setAccountCode("2000");
+            ap.setDebitAmount(new BigDecimal(amount));
+            ap.setCreditAmount(BigDecimal.ZERO);
+            JournalEntryLine cash = new JournalEntryLine();
+            cash.setAccountCode("1000");
+            cash.setDebitAmount(BigDecimal.ZERO);
+            cash.setCreditAmount(new BigDecimal(amount));
+            when(journals.findByUid(uid)).thenReturn(Optional.of(j));
+            when(lines.findByJournalEntryUid(uid)).thenReturn(List.of(ap, cash));
