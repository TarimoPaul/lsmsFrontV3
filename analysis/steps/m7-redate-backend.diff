+            assertThat(r.getErrors()).isZero();
+            assertThat(r.getEffectBeforeOriginalDate().get("1000")).isEqualByComparingTo("-6343326.33");
+            assertThat(r.getEffectBeforeOriginalDate().get("2000")).isEqualByComparingTo("6343326.33");
+            assertThat(r.getRows()).extracting(JournalRedateService.Row::getStatus).containsExactly("OK", "OK");
+            verify(engine, never()).reverse(anyString(), anyString(), anyString(), any(LocalDate.class));
+            verify(engine, never()).replay(any(), anyString(), any(), any(), any(), anyString(), anyList());
+        }
+
+        @Test
+        @DisplayName("real run: reversal on 04/10, the same lines (Dr 2000 / Cr 1000) reposted on 30/09 with the note")
+        void realRun() {
+            JournalRedateService.Result r = service.redate(List.of("j1", "j2"), sep30, NOTE, false, "boss");
