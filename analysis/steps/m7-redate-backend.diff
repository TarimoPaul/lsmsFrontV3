diff --git a/src/main/java/com/Lsms/CapitalAndExpenditure/gl/JournalRedateService.java b/src/main/java/com/Lsms/CapitalAndExpenditure/gl/JournalRedateService.java
new file mode 100644
index 0000000..8c663b9
--- /dev/null
+++ b/src/main/java/com/Lsms/CapitalAndExpenditure/gl/JournalRedateService.java
@@ -0,0 +1,174 @@
+package com.Lsms.CapitalAndExpenditure.gl;
+
+import lombok.Builder;
+import lombok.Data;
+import lombok.RequiredArgsConstructor;
+import lombok.extern.slf4j.Slf4j;
+import org.springframework.stereotype.Service;
+
+import java.math.BigDecimal;
+import java.time.LocalDate;
+import java.time.YearMonth;
+import java.util.ArrayList;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.TreeMap;
+
+/**
+ * Moves live journals to another date (M-7: the seven supplier payments recorded on
+ * 04/10 that settled debts paid from the bank in Feb–Jul belong on 30/09, before
+ * September is closed).
+ *
+ * Each journal is reversed ON ITS OWN DATE and its lines are posted again, unchanged
+ * (same accounts, amounts, reference type and reference), on the new date. Balances
+ * from the original date on are therefore untouched; only the days between the new
+ * date and the original one change. Nothing is written unless every journal passes
+ * the checks, and a dry run writes nothing at all.
+ */
+@Service
+@RequiredArgsConstructor
+@Slf4j
+public class JournalRedateService {
+
+    public static final String SOURCE = "GL_REDATE";
+    private static final int MIN_NOTE = 10;
+
+    private final PostingEngine postingEngine;
+    private final JournalEntryRepository journalEntryRepository;
+    private final JournalEntryLineRepository journalEntryLineRepository;
+    private final GlConfigService glConfigService;
+    private final GlPostingFailureService failureService;
+
+    @Data
+    @Builder
+    public static class Row {
+        private String journalUid;
+        private String entryNumber;
+        private String referenceType;
+        private String referenceUid;
+        private LocalDate fromDate;
+        private LocalDate toDate;
+        private BigDecimal total;
+        /** OK (dry run) / MOVED / INVALID / ERROR. */
+        private String status;
+        private String error;
+    }
+
+    @Data
+    @Builder
+    public static class Result {
+        private boolean dryRun;
+        private LocalDate newDate;
+        private String note;
+        private int journals;
+        private int moved;
+        private int errors;
+        /**
+         * Dr − Cr per account that moves to the new date: the balance of every day from
+         * the new date to the day before the original date changes by this much; from the
+         * original date on, nothing changes.
+         */
+        private Map<String, BigDecimal> effectBeforeOriginalDate;
+        private List<Row> rows;
+    }
+
+    public Result redate(List<String> journalUids, LocalDate newDate, String note, boolean dryRun, String by) {
+        if (!glConfigService.isPostingEnabled()) throw new IllegalStateException("GL posting imezimwa.");
+        if (newDate == null) throw new IllegalStateException("Tarehe mpya inahitajika.");
+        if (note == null || note.trim().length() < MIN_NOTE) {
+            throw new IllegalStateException("Maelezo ya angalau herufi " + MIN_NOTE + " yanahitajika.");
+        }
+        if (journalUids == null || journalUids.isEmpty()) throw new IllegalStateException("Hakuna journal iliyotajwa.");
+        if (newDate.isAfter(LocalDate.now())) throw new IllegalStateException("Tarehe mpya haiwezi kuwa ya baadaye.");
+        if (postingEngine.isPeriodClosed(YearMonth.from(newDate))) {
+            throw new IllegalStateException("Kipindi " + YearMonth.from(newDate) + " kimefungwa; tarehe mpya lazima iwe kwenye kipindi kilicho wazi.");
+        }
+        String text = note.trim();
+
+        List<Row> rows = new ArrayList<>();
+        List<JournalEntry> entries = new ArrayList<>();
+        Map<String, BigDecimal> effect = new TreeMap<>();
+        int invalid = 0;
+        for (String uid : new LinkedHashSet<>(journalUids)) {
+            JournalEntry j = journalEntryRepository.findByUid(uid).orElse(null);
+            String problem = check(j, newDate);
+            LocalDate from = j == null ? null : (j.getEventDate() != null ? j.getEventDate() : j.getEntryDate());
+            rows.add(Row.builder().journalUid(uid)
+                    .entryNumber(j != null ? j.getEntryNumber() : null)
+                    .referenceType(j != null ? j.getReferenceType() : null)
+                    .referenceUid(j != null ? j.getReferenceUid() : null)
+                    .fromDate(from).toDate(newDate)
+                    .total(j != null ? j.getTotalDebit() : null)
+                    .status(problem == null ? "OK" : "INVALID").error(problem).build());
+            if (problem != null) {
+                invalid++;
+                continue;
+            }
+            entries.add(j);
+            for (JournalEntryLine l : journalEntryLineRepository.findByJournalEntryUid(j.getUid())) {
+                effect.merge(l.getAccountCode(), nz(l.getDebitAmount()).subtract(nz(l.getCreditAmount())), BigDecimal::add);
+            }
+        }
+        if (!dryRun && invalid > 0) {
+            throw new IllegalStateException("Hakuna kilichoandikwa: journal " + invalid + " hazifai ("
+                    + rows.stream().filter(r -> r.getError() != null).map(r -> r.getJournalUid() + ": " + r.getError()).toList() + ")");
+        }
+
+        int moved = 0, errors = 0;
+        if (!dryRun) {
+            for (int i = 0, k = 0; i < rows.size(); i++) {
+                Row r = rows.get(i);
+                if (!"OK".equals(r.getStatus())) continue;
+                JournalEntry j = entries.get(k++);
+                List<PostingEngine.JournalLine> lines = new ArrayList<>();
+                for (JournalEntryLine l : journalEntryLineRepository.findByJournalEntryUid(j.getUid())) {
+                    lines.add(new PostingEngine.JournalLine(l.getAccountCode(), nz(l.getDebitAmount()), nz(l.getCreditAmount()), text));
+                }
+                try (AutoCloseable ignored = postingEngine.withThrowOnError()) {
+                    postingEngine.reverse(j.getUid(), by, text, r.getFromDate());
+                    postingEngine.replay(JournalEventType.valueOf(j.getReferenceType()), j.getReferenceUid(),
+                            j.getReferenceNumber(), newDate, j.getBranchUid(), by, lines);
+                    r.setStatus("MOVED");
+                    moved++;
+                } catch (Exception e) {
+                    // The reversal may already be written: the failure row keeps the lines, so
+                    // "Jaribu tena" posts them on the new date.
+                    r.setStatus("ERROR");
+                    r.setError(GlPostingFailureService.messageChain(e));
+                    errors++;
+                    log.error("GL redate of {} to {} failed: {}", j.getEntryNumber(), newDate, r.getError());
+                    failureService.record(SOURCE, j.getUid(), j.getEntryNumber(), e);
+                }
+            }
+        }
+        log.warn("GL redate (dryRun={}) by {} to {}: {} journals, {} moved, {} errors, effect {}",
+                dryRun, by, newDate, rows.size(), moved, errors, effect);
+        return Result.builder().dryRun(dryRun).newDate(newDate).note(text).journals(rows.size())
+                .moved(moved).errors(errors + invalid).effectBeforeOriginalDate(effect).rows(rows).build();
+    }
+
+    /** Why a journal cannot be moved; null when it can. */
+    private String check(JournalEntry j, LocalDate newDate) {
+        if (j == null) return "haipo";
+        if (Boolean.TRUE.equals(j.getIsDeleted())) return "imefutwa";
+        if (Boolean.TRUE.equals(j.getIsReversal())) return "ni reversal";
+        if (journalEntryRepository.existsByReversedEntryUidAndIsDeletedFalse(j.getUid())) return "imeshageuzwa";
+        try {
+            JournalEventType.valueOf(j.getReferenceType());
+        } catch (Exception e) {
+            return "aina ya tukio haijulikani: " + j.getReferenceType();
+        }
+        LocalDate from = j.getEventDate() != null ? j.getEventDate() : j.getEntryDate();
+        if (from == null) return "haina tarehe";
+        if (from.equals(newDate)) return "tayari iko tarehe " + newDate;
+        if (postingEngine.isPeriodClosed(YearMonth.from(from))) {
+            return "kipindi chake (" + YearMonth.from(from) + ") kimefungwa; reversal isingekaa tarehe yake";
+        }
+        return null;
+    }
+
+    private static BigDecimal nz(BigDecimal v) {
+        return v != null ? v : BigDecimal.ZERO;
+    }
+}
diff --git a/src/test/java/com/Lsms/CapitalAndExpenditure/gl/GlRedateRehearsalCheck.java b/src/test/java/com/Lsms/CapitalAndExpenditure/gl/GlRedateRehearsalCheck.java
new file mode 100644
index 0000000..3bfc362
--- /dev/null
+++ b/src/test/java/com/Lsms/CapitalAndExpenditure/gl/GlRedateRehearsalCheck.java
@@ -0,0 +1,90 @@
+package com.Lsms.CapitalAndExpenditure.gl;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfSystemProperty;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.jdbc.core.JdbcTemplate;
+
+import java.math.BigDecimal;
+import java.time.LocalDate;
+import java.util.List;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+/**
+ * Rehearsal of the M-7 step on a THROW-AWAY copy of a prod dump: the seven live
+ * PURCHASE_PAYMENT journals of 04/10 move to 30/09. Not part of the build:
+ *   mvnw -o test -Dtest=GlRedateRehearsalCheck -Dgl.redate.check=true \
+ *        -Dspring.datasource.url=jdbc:postgresql://localhost:5432/lsms_m7_rehearsal
+ */
+@SpringBootTest
+@EnabledIfSystemProperty(named = "gl.redate.check", matches = "true")
+class GlRedateRehearsalCheck {
+
+    private static final String NOTE = "Malipo ya zamani (Feb–Jul) kutoka benki; yalirekodiwa 04/10";
+    private static final LocalDate SEP30 = LocalDate.of(2026, 9, 30);
+
+    @Autowired
+    private JournalRedateService service;
+    @Autowired
+    private JdbcTemplate jdbc;
+
+    private BigDecimal balance(String code, String asOf) {
+        return jdbc.queryForObject("SELECT coalesce(sum(l.debit_amount - l.credit_amount), 0) FROM journal_entry j "
+                + "JOIN journal_entry_line l ON l.journal_entry_uid = j.uid WHERE NOT j.is_deleted AND l.account_code = ? "
+                + "AND j.entry_date <= ?::date", BigDecimal.class, code, asOf);
+    }
+
+    private BigDecimal tbDifference() {
+        return jdbc.queryForObject("SELECT coalesce(sum(l.debit_amount) - sum(l.credit_amount), 0) FROM journal_entry j "
+                + "JOIN journal_entry_line l ON l.journal_entry_uid = j.uid WHERE NOT j.is_deleted", BigDecimal.class);
+    }
+
+    @Test
+    void moveTheSevenPaymentsOfOctober4ToSeptember30() {
+        List<String> uids = jdbc.queryForList("SELECT j.uid FROM journal_entry j WHERE NOT j.is_deleted AND NOT j.is_reversal "
+                + "AND j.reference_type = 'PURCHASE_PAYMENT' AND j.entry_date = '2026-10-04' AND NOT EXISTS "
+                + "(SELECT 1 FROM journal_entry r WHERE r.reversed_entry_uid = j.uid AND NOT r.is_deleted) ORDER BY j.uid", String.class);
+        assertThat(uids).hasSize(7);
+        String[][] points = {{"1000", "2026-09-30"}, {"2000", "2026-09-30"}, {"1000", "2026-10-03"}, {"1000", "2026-10-31"}, {"2000", "2026-10-31"}};
+        BigDecimal[] before = new BigDecimal[points.length];
+        for (int i = 0; i < points.length; i++) before[i] = balance(points[i][0], points[i][1]);
+
+        JournalRedateService.Result dry = service.redate(uids, SEP30, NOTE, true, "QA-M7");
+        System.out.println("M7CHECK dryRun effect " + dry.getEffectBeforeOriginalDate() + " errors " + dry.getErrors());
+        assertThat(dry.getErrors()).isZero();
+        assertThat(balance("1000", "2026-09-30")).isEqualByComparingTo(before[0]);
+
+        JournalRedateService.Result r = service.redate(uids, SEP30, NOTE, false, "QA-M7");
+        System.out.println("M7CHECK moved " + r.getMoved() + " errors " + r.getErrors());
+        assertThat(r.getMoved()).isEqualTo(7);
+        assertThat(r.getErrors()).isZero();
+        BigDecimal x = new BigDecimal("6751443.39");
+        for (int i = 0; i < points.length; i++) {
+            BigDecimal after = balance(points[i][0], points[i][1]);
+            System.out.println("M7CHECK " + points[i][0] + " " + points[i][1] + " before " + before[i] + " after " + after
+                    + " change " + after.subtract(before[i]));
+        }
+        assertThat(balance("1000", "2026-09-30")).isEqualByComparingTo(before[0].subtract(x));
+        assertThat(balance("2000", "2026-09-30")).isEqualByComparingTo(before[1].add(x));
+        assertThat(balance("2000", "2026-09-30")).isEqualByComparingTo("0");
+        assertThat(balance("1000", "2026-10-03")).isEqualByComparingTo(before[2].subtract(x));
+        assertThat(balance("1000", "2026-10-31")).isEqualByComparingTo(before[3]);
+        assertThat(balance("2000", "2026-10-31")).isEqualByComparingTo(before[4]);
+        assertThat(tbDifference()).isEqualByComparingTo("0");
+        Integer reversedOn4 = jdbc.queryForObject("SELECT count(*) FROM journal_entry WHERE is_reversal AND NOT is_deleted "
+                + "AND reversed_entry_uid IN (" + String.join(",", uids.stream().map(u -> "'" + u + "'").toList()) + ") "
+                + "AND entry_date = '2026-10-04'", Integer.class);
+        Integer repostedOn30 = jdbc.queryForObject("SELECT count(*) FROM journal_entry WHERE NOT is_reversal AND NOT is_deleted "
+                + "AND reference_type = 'PURCHASE_PAYMENT' AND entry_date = '2026-09-30' AND reference_uid IN "
+                + "(SELECT reference_uid FROM journal_entry WHERE uid IN (" + String.join(",", uids.stream().map(u -> "'" + u + "'").toList()) + "))", Integer.class);
+        System.out.println("M7CHECK reversals on 04/10 " + reversedOn4 + ", reposts on 30/09 " + repostedOn30);
+        assertThat(reversedOn4).isEqualTo(7);
+        assertThat(repostedOn30).isEqualTo(7);
+
+        // A second run is refused: every original is now reversed.
+        assertThatThrownBy(() -> service.redate(uids, SEP30, NOTE, false, "QA-M7")).hasMessageContaining("imeshageuzwa");
+    }
+}
