diff --git a/src/main/resources/db/migration/V132__Safe_Box_Deposit_Remainder_Reason.sql b/src/main/resources/db/migration/V132__Safe_Box_Deposit_Remainder_Reason.sql
new file mode 100644
index 0000000..1dc0beb
--- /dev/null
+++ b/src/main/resources/db/migration/V132__Safe_Box_Deposit_Remainder_Reason.sql
@@ -0,0 +1,7 @@
+-- V132: a cashier may submit only part of what is in the safe (the rest stays behind,
+-- e.g. as change, and keeps showing as owed until it is submitted). remainder_reason
+-- records why the rest was kept back, for the manager who confirms the deposit.
+-- Nullable, no default: existing rows and full deposits simply have none.
+
+ALTER TABLE safe_box_deposits
+    ADD COLUMN IF NOT EXISTS remainder_reason TEXT;
