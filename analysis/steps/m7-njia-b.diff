+@echo off
+rem HATUA 43 - M-7 KWENYE PROD (njia B). INAANDIKA KWENYE GL YA PROD: journals 2 za mkono (MANUAL_ADJUSTMENT):
+rem   (1) 04/10: Dr 1000 / Cr 2000 6,751,443.39 - kufuta malipo 7 ya wasambazaji ya 04/10 (entry numbers kwenye maelezo);
+rem   (2) 30/09: Dr 2000 / Cr 1000 6,751,443.39 - "malipo ya Feb-Jul kutoka benki".
+rem Mpangilio (MPANGO 1.8/1.9): deploy 2.2.71 -> marekebisho ya 1.8 -> HATUA HII -> kufunga Jan-Sep. Staging (hatua 40) ipite kwanza.
+rem Kupitia API tu; hakuna ssh wala query kwenye DB ya prod (kanuni ya 15/10).
+rem Kabla ya kuendesha: weka PROD_API (mfano: set PROD_API=http://localhost:PORT ya tunnel yako ya prod) kwenye dirisha hili.
+rem Itakuuliza email na password ya mtumiaji mwenye FINANCE_WRITE (CEO); password haiandikwi kwenye faili lolote.
+rem Hatua: (a) kagua - haiandiki: journals 7, jumla, Septemba wazi?, salio la kabla; (b) unaandika "andika" -> journals 2 + ukaguzi.
+rem Inakataa yenyewe ikiwa: journals si 7 / jumla si 6,751,443.39 / M-7 imeshaandikwa / Septemba imefungwa.
+rem Matokeo: analysis\steps\43-m7-prod.log na analysis\steps\43-m7-prod.json
+cd /d "D:\MY PROJECT\DUKA PROJECT\LsmsVersion3\lsmsFrontV3"
+set L=analysis\steps\43-m7-prod.log
+echo ---MWENDESHO-43--- > %L%
+if "%PROD_API%"=="" (
+  echo PROD_API haijawekwa >> %L%
+  goto fail
+)
+echo PROD_API=%PROD_API% >> %L%
+set /p M7_EMAIL=Email ya mtumiaji mwenye FINANCE_WRITE (PROD):
+set /p M7_PASS=Password (PROD):
+echo ---KAGUA-HAIANDIKI--- >> %L%
+node analysis\steps\43-m7-prod.mjs kagua >> %L% 2>&1
+if errorlevel 1 goto fail
+type %L%
+set JIBU=
+set /p JIBU=Andika "andika" kuandika journals 2 kwenye PROD (kingine chochote = simama):
+if /i not "%JIBU%"=="andika" (
+  echo ---IMESIMAMISHWA-NA-MMILIKI--- >> %L%
+  goto stop
+)
+echo ---ANDIKA--- >> %L%
+node analysis\steps\43-m7-prod.mjs andika >> %L% 2>&1
+if errorlevel 1 goto fail
+echo ---OK--- >> %L%
+echo OK. Matokeo: %L% na analysis\steps\43-m7-prod.json
+goto end
+:stop
+set M7_PASS=
+echo Imesimamishwa; hakuna kilichoandikwa. Matokeo: %L%
+goto end
+:fail
+set M7_PASS=
+echo ---IMESHINDWA--- >> %L%
+echo IMESHINDWA - soma %L%
+:end
+set M7_PASS=
