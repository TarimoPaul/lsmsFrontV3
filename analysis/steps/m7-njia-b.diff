+// HATUA 43 - M-7 kwenye PROD (njia B: journals 2 za mkono), BAADA ya deploy 2.2.71 na §1.8, KABLA ya kufunga Jan-Sep.
+// Kupitia API tu (kanuni ya 15/10: hakuna query kwenye DB ya prod). Mantiki ya kuandika ni ILEILE ya staging:
+// kipande cha M-7 kinakatwa kutoka 39-toleo1-jaribu.mjs (awamu B) na kuendeshwa hapa bila kubadilishwa.
+//   node analysis\steps\43-m7-prod.mjs kagua   -> journals 7 kutoka API, jumla, Septemba wazi?, salio kabla; HAIANDIKI
+//   node analysis\steps\43-m7-prod.mjs andika  -> inaandika journals 2 na kukagua tofauti
+// Inahitaji: PROD_API (mfano http://localhost:PORT ya tunnel ya prod; mmiliki anaiweka), M7_EMAIL na M7_PASS
+// (mtumiaji mwenye FINANCE_WRITE). Password haiandikwi popote.
+import fs from 'node:fs';
+
+const MODE = (process.argv[2] || '').toLowerCase();
+if (!['kagua', 'andika'].includes(MODE)) { console.log('Tumia: node 43-m7-prod.mjs kagua|andika'); process.exit(1); }
+const API = process.env.PROD_API;
+if (!API) { console.log('PROD_API haijawekwa'); process.exit(1); }
+
+const results = [];
+const check = (id, ok, msg) => { results.push([id, ok]); console.log(`${ok === null ? 'SKIP' : ok ? 'PASS' : 'FAIL'} ${id}: ${msg}`); };
+const p2 = (n) => String(n).padStart(2, '0');
+const t0 = new Date();
+const today = `${t0.getFullYear()}-${p2(t0.getMonth() + 1)}-${p2(t0.getDate())}`;
+const short = (v) => JSON.stringify(v).slice(0, 300);
+const money = (v) => Number(v ?? 0).toLocaleString('en-US', { maximumFractionDigits: 2 });
+
+let r = await fetch(`${API}/api/auth/login`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email: process.env.M7_EMAIL, password: process.env.M7_PASS }) });
+if (!r.ok) { console.log('LOGIN_IMESHINDWA', r.status); process.exit(1); }
+const login = (await r.json()).data;
+let token = login.tokenInfo.token;
+if (login.requiresBranchSelection || (!login.selectedBranchUid && (login.branches ?? []).length > 1)) {
+  const b = login.branches[0];
+  r = await fetch(`${API}/api/auth/select-branch`, { method: 'POST', headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' }, body: JSON.stringify({ branchUid: b.uid ?? b.branchUid }) });
+  const sel = (await r.json()).data;
+  token = (sel?.tokenInfo ?? sel)?.token ?? token;
+}
+const H = { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' };
+async function call(method, path, body) {
+  const res = await fetch(`${API}${path}`, { method, headers: H, body: body === undefined ? undefined : JSON.stringify(body) });
+  const t = await res.text();
+  let j; try { j = JSON.parse(t); } catch { j = { status: 'Error', message: t.slice(0, 300) }; }
+  return { http: res.status, ok: res.status < 300 && j?.status !== 'Error' && j?.status !== 'Failure', status: j?.status, data: j?.data, message: j?.message, raw: j };
+}
+async function pages(path) {
+  const out = [];
+  for (let page = 0; page < 50; page++) {
+    const q = await call('GET', `${path}&page=${page}&size=200`);
+    const list = q.raw?.data ?? [];
+    out.push(...list);
+    if (list.length < 200) break;
+  }
+  return out;
+}
+
+// Journals 7 = PURCHASE_PAYMENT za 04/10, si reversal, na hazijageuzwa (reversal ingekuwa PURCHASE_PAYMENT ya 04/10 au baadaye).
+const pp = await pages('/api/v1/gl/journal-entries?startDate=2026-10-04&endDate=2026-10-04&referenceType=PURCHASE_PAYMENT');
+const revs = new Set((await pages(`/api/v1/gl/journal-entries?startDate=2026-10-04&endDate=${today}&referenceType=PURCHASE_PAYMENT`))
+  .filter((e) => e.isReversal).map((e) => e.reversedEntryUid));
+const live = pp.filter((e) => !e.isReversal && !revs.has(e.uid)).sort((a, b) => a.uid.localeCompare(b.uid));
+const M7J = live.map((e) => ['M7J', e.uid, e.entryNumber, String(e.totalDebit)]);
+for (const x of M7J) console.log(`  ${x.join('|')}`);
+const rows = (tag) => (tag === 'M7J' ? M7J : []);
+
+const src = fs.readFileSync('analysis/steps/39-toleo1-jaribu.mjs', 'utf8');
+const a = src.indexOf('  // ── M-7 (19/10, njia B');
+const b = src.indexOf('  // ── Vipindi: funga Jan-Sep 2026 ──');
+if (a < 0 || b < 0) { console.log('KIPANDE_CHA_M7_HAKIPO kwenye 39-toleo1-jaribu.mjs'); process.exit(1); }
+const AsyncFunction = Object.getPrototypeOf(async function () {}).constructor;
+await new AsyncFunction('rows', 'check', 'call', 'money', 'short', 'today', 'fs', 'M7_OUT', 'M7_WRITE', src.slice(a, b))(
+  rows, check, call, money, short, today, fs, 'analysis/steps/43-m7-prod.json', MODE === 'andika');
+
+const fails = results.filter(([, ok]) => ok === false).length;
+console.log(`MUHTASARI M-7 prod (${MODE}): PASS ${results.length - fails}, FAIL ${fails}`);
+process.exit(fails ? 1 : 0);
