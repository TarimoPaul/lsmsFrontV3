@@ -0,0 +1,154 @@
+package com.Lsms.uaa.entity;
+
+import com.Lsms.Role.Repository.PermissionRepository;
+import com.Lsms.Role.Repository.RoleRepository;
+import com.Lsms.uaa.repository.UserRepository;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.DisplayName;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.core.io.ClassPathResource;
+import org.springframework.security.crypto.password.PasswordEncoder;
+import org.springframework.test.util.ReflectionTestUtils;
+
+import java.io.InputStream;
+import java.nio.charset.StandardCharsets;
+import java.util.Optional;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.ArgumentMatchers.argThat;
+import static org.mockito.Mockito.*;
+
+/**
+ * 2.2.72 (21/10): on 21/10 15:13:12 the backend restart of §1.8 (c) ran with ROOT_EMAIL=admin@admin.com,
+ * and DataInitializer re-activated that account (deactivated by the owner at 15:10:32). Now boot never
+ * makes a non-root account root, still re-activates / unlocks an account that IS root (break-glass),
+ * and has no default root password.
+ */
+class DataInitializerRootUserTest {
+
+    private UserRepository users;
+    private DataInitializer init;
+
+    @BeforeEach
+    void setUp() {
+        users = mock(UserRepository.class);
+        PasswordEncoder encoder = mock(PasswordEncoder.class);
+        when(encoder.encode(any())).thenReturn("hash");
+        init = new DataInitializer(users, mock(RoleRepository.class), mock(PermissionRepository.class), encoder);
+        ReflectionTestUtils.setField(init, "rootEmail", "admin@admin.com");
+        ReflectionTestUtils.setField(init, "rootPassword", "set-by-env");
+        when(users.save(any(User.class))).thenAnswer(i -> i.getArgument(0));
+    }
+
+    private static User user(boolean root, User.Status status) {
+        User u = new User();
+        u.setEmail("admin@admin.com");
+        u.setIsRoot(root);
+        u.setStatus(status);
+        u.setEmailVerified(true);
+        u.setIsLocked(false);
+        return u;
+    }
+
+    private void boot() {
+        ReflectionTestUtils.invokeMethod(init, "initializeRootUser");
+    }
+
+    @Test
+    @DisplayName("(a) ROOT_EMAIL at a non-root ACTIVE account: not promoted, nothing saved")
+    void nonRootNotPromoted() {
+        User u = user(false, User.Status.ACTIVE);
+        when(users.findByEmail("admin@admin.com")).thenReturn(Optional.of(u));
+        boot();
+        assertThat(u.getIsRoot()).isFalse();
+        verify(users, never()).save(any());
+    }
+
+    @Test
+    @DisplayName("(a) ROOT_EMAIL at a non-root INACTIVE account: stays INACTIVE and non-root")
+    void nonRootInactiveUntouched() {
+        User u = user(false, User.Status.INACTIVE);
+        when(users.findByEmail("admin@admin.com")).thenReturn(Optional.of(u));
+        boot();
+        assertThat(u.getStatus()).isEqualTo(User.Status.INACTIVE);
+        assertThat(u.getIsRoot()).isFalse();
+        verify(users, never()).save(any());
+    }
+
+    @Test
+    @DisplayName("(a) break-glass kept: an INACTIVE account that IS root is re-activated")
+    void rootReactivated() {
+        User u = user(true, User.Status.INACTIVE);
+        when(users.findByEmail("admin@admin.com")).thenReturn(Optional.of(u));
+        boot();
+        assertThat(u.getStatus()).isEqualTo(User.Status.ACTIVE);
+        verify(users).save(u);
+    }
+
+    @Test
+    @DisplayName("(a) break-glass kept: a LOCKED root account is unlocked and ACTIVE")
+    void rootUnlocked() {
+        User u = user(true, User.Status.ACTIVE);
+        u.lock();
+        when(users.findByEmail("admin@admin.com")).thenReturn(Optional.of(u));
+        boot();
+        assertThat(u.getIsLocked()).isFalse();
+        assertThat(u.getStatus()).isEqualTo(User.Status.ACTIVE);
+        verify(users).save(u);
+    }
+
+    @Test
+    @DisplayName("(a) a root account already right is not saved")
+    void rootAlreadyRight() {
+        when(users.findByEmail("admin@admin.com")).thenReturn(Optional.of(user(true, User.Status.ACTIVE)));
+        boot();
+        verify(users, never()).save(any());
+    }
+
+    @Test
+    @DisplayName("(a) ROOT_EMAIL with no account while a root exists: nothing created")
+    void noCreateWhenRootExists() {
+        when(users.findByEmail("admin@admin.com")).thenReturn(Optional.empty());
+        when(users.countByIsRootTrue()).thenReturn(1L);
+        boot();
+        verify(users, never()).save(any());
+    }
+
+    @Test
+    @DisplayName("(b) first install with no ROOT_PASSWORD: no ROOT user is created")
+    void firstInstallWithoutPassword() {
+        ReflectionTestUtils.setField(init, "rootPassword", "");
+        when(users.findByEmail("admin@admin.com")).thenReturn(Optional.empty());
+        when(users.countByIsRootTrue()).thenReturn(0L);
+        boot();
+        verify(users, never()).save(any());
+    }
+
+    @Test
+    @DisplayName("first install with ROOT_PASSWORD: the ROOT user is created ACTIVE and root")
+    void firstInstallCreatesRoot() {
+        when(users.findByEmail("admin@admin.com")).thenReturn(Optional.empty());
+        when(users.countByIsRootTrue()).thenReturn(0L);
+        boot();
+        verify(users).save(argThat(u -> u.getIsRoot() && u.getStatus() == User.Status.ACTIVE
+                && "admin@admin.com".equals(u.getEmail()) && "hash".equals(u.getPassword())));
+    }
+
+    @Test
+    @DisplayName("(b) no default root password in DataInitializer's @Value")
+    void noCodeDefault() throws Exception {
+        Value v = DataInitializer.class.getDeclaredField("rootPassword").getAnnotation(Value.class);
+        assertThat(v.value()).isEqualTo("${root.password:}");
+    }
+
+    @Test
+    @DisplayName("(b) no default root password in application-pro.properties")
+    void noProfileDefault() throws Exception {
+        try (InputStream in = new ClassPathResource("application-pro.properties").getInputStream()) {
+            String props = new String(in.readAllBytes(), StandardCharsets.UTF_8);
+            assertThat(props).contains("root.password=${ROOT_PASSWORD:}").doesNotContain("Root@123");
+        }
+    }
+}
