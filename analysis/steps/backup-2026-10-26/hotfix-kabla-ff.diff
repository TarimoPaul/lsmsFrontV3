--- /dev/null
+++ b/src/main/java/com/Lsms/CapitalAndExpenditure/gl/GlClosedPeriodException.java
@@ -0,0 +1,28 @@
+package com.Lsms.CapitalAndExpenditure.gl;
+
+import java.time.LocalDate;
+import java.time.YearMonth;
+
+/**
+ * A correction, rebuild or scheduler run tried to write a journal that belongs to a CLOSED
+ * period (2.2.72). Live business events and retries are not refused: they are booked on the
+ * first open day (MPANGO §1.9, decision 4). A scheduler refusal is kept in gl_posting_failure
+ * instead of thrown. An IllegalStateException, so the GL endpoints that already turn those
+ * into an Error response show this message as it is.
+ */
+public class GlClosedPeriodException extends IllegalStateException {
+
+    private final YearMonth period;
+
+    public GlClosedPeriodException(String operation, LocalDate date) {
+        super(String.format(
+                "Kipindi %s kimefungwa: %s hairuhusiwi kwa journal ya tarehe %s. Fungua kipindi upya kwanza (kwa sababu). / "
+                        + "Period %s is closed: %s refused for a journal dated %s; reopen the period first.",
+                YearMonth.from(date), operation, date, YearMonth.from(date), operation, date));
+        this.period = YearMonth.from(date);
+    }
+
+    public YearMonth getPeriod() {
+        return period;
+    }
+}
