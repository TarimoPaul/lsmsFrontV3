+# A prod image comes from main or hotfix/* ONLY (analysis/MATAWI.md in lsmsFrontV3), and never carries a
+# Flyway migration that main does not have: an image built from a feature branch runs migrations that the
+# next main release knows nothing about. $Extra = migration names inside an image's jar (-DeployOnly).
+function Assert-ReleaseBranch([string]$Root, [string[]]$Extra = @()) {
+    $ErrorActionPreference = 'Continue'
+    $branch = (git -C $Root symbolic-ref --quiet --short HEAD) -join ''
+    if ($LASTEXITCODE -ne 0 -or -not $branch) { Fail "HEAD haiko kwenye branch (detached) - build ya prod hutoka main au hotfix/* tu." }
+    if ($branch -ne 'main' -and $branch -notlike 'hotfix/*') {
+        Fail "Branch ni '$branch' - build ya prod hutoka main au hotfix/* tu. Merge kwenye main kwanza."
+    }
+    $onMain = @(git -C $Root -c core.quotepath=false ls-tree -r --name-only main -- $MigrationDir | ForEach-Object { Split-Path -Leaf $_ })
+    if ($LASTEXITCODE -ne 0 -or -not $onMain.Count) { Fail "Migrations za main hazikusomeka (git ls-tree main -- $MigrationDir)." }
+    $here = @(git -C $Root -c core.quotepath=false ls-tree -r --name-only HEAD -- $MigrationDir | ForEach-Object { Split-Path -Leaf $_ })
+    $here += @(Get-ChildItem (Join-Path $Root $MigrationDir) -File | ForEach-Object { $_.Name })
+    $here += @($Extra | ForEach-Object { Split-Path -Leaf $_ })
+    $notOnMain = @($here | Where-Object { $_ -and $onMain -notcontains $_ } | Sort-Object -Unique)
+    if ($notOnMain.Count) {
+        Fail ("Faili za db/migration ambazo HAZIPO kwenye main ($($notOnMain.Count)) - hotfix haiongezi migration; feature iende main kwanza:`n    " + ($notOnMain -join "`n    "))
+    }
+    Step "Branch ya build: $branch (migrations zote $(@($here | Sort-Object -Unique).Count) ziko kwenye main)"
+}
 
