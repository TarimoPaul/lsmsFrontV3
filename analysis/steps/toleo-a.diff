@@ -0,0 +1,184 @@
+package com.Lsms.Counting.Asset;
+
+import com.Lsms.uaa.utils.Response;
+import com.Lsms.uaa.utils.ResponseStatus;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.http.ResponseEntity;
+import org.springframework.security.access.prepost.PreAuthorize;
+import org.springframework.web.bind.annotation.DeleteMapping;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RequestParam;
+import org.springframework.web.bind.annotation.RestController;
+
+import java.util.List;
+
+/**
+ * Asset register + asset counts (V127).
+ *
+ *  ASSET_COUNT_MANAGE  — fill / edit the register (quantities are proposals)
+ *  ASSET_COUNT_APPROVE — the CEO: confirm quantities, decide count differences,
+ *                        set the schedule, retire assets, cancel a count
+ *  COUNTING_PERFORM    — run the periodic count (blind: the confirmed quantity is
+ *                        never sent while the count is IN_PROGRESS, and the
+ *                        register itself is not readable with this permission)
+ */
+@RestController
+@RequestMapping("/api/v1/counting/assets")
+public class AssetCountController {
+
+    private static final Logger logger = LoggerFactory.getLogger(AssetCountController.class);
+
+    private static final String MANAGE = "hasPermission(null, 'ASSET_COUNT_MANAGE')";
+    private static final String APPROVE = "hasPermission(null, 'ASSET_COUNT_APPROVE')";
+    private static final String PERFORM = "hasPermission(null, 'COUNTING_PERFORM')";
+    private static final String REGISTER = MANAGE + " or " + APPROVE;
+    private static final String ANY = MANAGE + " or " + APPROVE + " or " + PERFORM;
+    private static final String COUNTS = APPROVE + " or " + PERFORM;
+
+    private final AssetCountService service;
+
+    public AssetCountController(AssetCountService service) {
+        this.service = service;
+    }
+
+    // ── register ─────────────────────────────────────────────────────────────────
+
+    @GetMapping
+    @PreAuthorize(REGISTER)
+    public ResponseEntity<Response<List<AssetDtos.Item>>> register() {
+        return ResponseEntity.ok(new Response<>(ResponseStatus.Success, service.register(), "OK"));
+    }
+
+    @PostMapping
+    @PreAuthorize(MANAGE)
+    public ResponseEntity<Response<AssetDtos.Item>> create(@RequestBody AssetDtos.SaveItem dto) {
+        return respond(service.saveItem(null, dto));
+    }
+
+    @PutMapping("/{uid}")
+    @PreAuthorize(MANAGE)
+    public ResponseEntity<Response<AssetDtos.Item>> update(@PathVariable String uid, @RequestBody AssetDtos.SaveItem dto) {
+        return respond(service.saveItem(uid, dto));
+    }
+
+    @DeleteMapping("/{uid}")
+    @PreAuthorize(MANAGE)
+    public ResponseEntity<Response<Boolean>> delete(@PathVariable String uid) {
+        return respond(service.deleteItem(uid));
+    }
+
+    @PostMapping("/approve")
+    @PreAuthorize(APPROVE)
+    public ResponseEntity<Response<List<AssetDtos.Item>>> approveItems(@RequestBody AssetDtos.Uids dto) {
+        return respond(service.approveItems(dto != null ? dto.getUids() : null));
+    }
+
+    @PostMapping("/{uid}/reject")
+    @PreAuthorize(APPROVE)
+    public ResponseEntity<Response<AssetDtos.Item>> reject(@PathVariable String uid,
+                                                           @RequestBody(required = false) AssetDtos.Reason dto) {
+        return respond(service.rejectItem(uid, dto != null ? dto.getReason() : null));
+    }
+
+    @PostMapping("/{uid}/retire")
+    @PreAuthorize(APPROVE)
+    public ResponseEntity<Response<AssetDtos.Item>> retire(@PathVariable String uid,
+                                                           @RequestBody(required = false) AssetDtos.Reason dto) {
+        return respond(service.retireItem(uid, dto != null ? dto.getReason() : null));
+    }
+
+    // ── schedule + status ────────────────────────────────────────────────────────
+
+    @GetMapping("/status")
+    @PreAuthorize(ANY)
+    public ResponseEntity<Response<AssetDtos.Status>> status() {
+        return ResponseEntity.ok(new Response<>(ResponseStatus.Success, service.status(), "OK"));
+    }
+
+    @PutMapping("/schedule")
+    @PreAuthorize(APPROVE)
+    public ResponseEntity<Response<AssetDtos.Status>> saveSchedule(@RequestBody AssetDtos.Schedule dto) {
+        return respond(service.saveSchedule(dto));
+    }
+
+    // ── counts ───────────────────────────────────────────────────────────────────
+
+    @PostMapping("/counts")
+    @PreAuthorize(PERFORM)
+    public ResponseEntity<Response<AssetDtos.Session>> start() {
+        return respond(service.start());
+    }
+
+    /** "Nothing open" is a normal answer: Success with data null. */
+    @GetMapping("/counts/active")
+    @PreAuthorize(COUNTS)
+    public ResponseEntity<Response<AssetDtos.Session>> active() {
+        return ResponseEntity.ok(new Response<>(ResponseStatus.Success, service.active(), "OK"));
+    }
+
+    @GetMapping("/counts")
+    @PreAuthorize(COUNTS)
+    public ResponseEntity<Response<List<AssetDtos.Session>>> list(@RequestParam(required = false) String status) {
+        return ResponseEntity.ok(new Response<>(ResponseStatus.Success, service.list(status), "OK"));
+    }
+
+    @GetMapping("/counts/{uid}")
+    @PreAuthorize(COUNTS)
+    public ResponseEntity<Response<AssetDtos.Session>> get(@PathVariable String uid) {
+        return respond(service.get(uid));
+    }
+
+    @PutMapping("/counts/{uid}/lines/{lineUid}")
+    @PreAuthorize(PERFORM)
+    public ResponseEntity<Response<AssetDtos.Line>> submitLine(@PathVariable String uid, @PathVariable String lineUid,
+                                                               @RequestBody AssetDtos.Qty dto) {
+        return respond(service.submitLine(uid, lineUid, dto != null ? dto.getCountedQty() : null));
+    }
+
+    @PostMapping("/counts/{uid}/complete")
+    @PreAuthorize(PERFORM)
+    public ResponseEntity<Response<AssetDtos.Session>> complete(@PathVariable String uid) {
+        return respond(service.complete(uid));
+    }
+
+    @PutMapping("/counts/{uid}/lines/{lineUid}/explanation")
+    @PreAuthorize(PERFORM)
+    public ResponseEntity<Response<AssetDtos.Line>> explain(@PathVariable String uid, @PathVariable String lineUid,
+                                                            @RequestBody AssetDtos.Reason dto) {
+        return respond(service.explain(uid, lineUid, dto != null ? dto.getReason() : null,
+                dto != null ? dto.getNote() : null));
+    }
+
+    @PostMapping("/counts/{uid}/approve")
+    @PreAuthorize(APPROVE)
+    public ResponseEntity<Response<AssetDtos.Session>> approve(@PathVariable String uid,
+                                                               @RequestBody(required = false) AssetDtos.Approve dto) {
+        try {
+            return respond(service.approve(uid, dto != null ? dto.getDecisions() : null));
+        } catch (Exception e) {
+            // The service rolled everything back (e.g. the staff-charge GL post failed).
+            logger.error("Asset count approval failed for {}: {}", uid, e.getMessage(), e);
+            return ResponseEntity.badRequest().body(new Response<>(ResponseStatus.Error, null,
+                    "Imeshindikana kuthibitisha uhakiki — hakuna kilichobadilishwa. Jaribu tena."));
+        }
+    }
+
+    @PostMapping("/counts/{uid}/cancel")
+    @PreAuthorize(APPROVE)
+    public ResponseEntity<Response<AssetDtos.Session>> cancel(@PathVariable String uid,
+                                                              @RequestBody(required = false) AssetDtos.Reason dto) {
+        return respond(service.cancel(uid, dto != null ? dto.getReason() : null));
+    }
+
+    private static <T> ResponseEntity<Response<T>> respond(Response<T> result) {
+        return result.getStatus() == ResponseStatus.Success
+                ? ResponseEntity.ok(result)
+                : ResponseEntity.badRequest().body(result);
+    }
+}
