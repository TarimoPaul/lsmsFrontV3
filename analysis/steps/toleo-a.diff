+    /** The CEO confirms the proposed quantities — they become the official ones. */
+    @Transactional
+    public Response<List<AssetDtos.Item>> approveItems(List<String> uids) {
+        if (uids == null || uids.isEmpty()) return fail("Chagua mali za kuthibitisha.");
+        LocalDateTime now = LocalDateTime.now();
+        int done = 0;
+        for (AssetItem item : items.findByUidIn(uids)) {
+            if (Boolean.TRUE.equals(item.getIsDeleted()) || !inBranch(item.getBranchUid())) continue;
+            if (AssetItem.RETIRED.equals(item.getStatus()) || item.getProposedQty() == null) continue;
+            item.setApprovedQty(item.getProposedQty());
+            item.setProposedQty(null);
+            item.setStatus(AssetItem.APPROVED);
+            item.setApprovedByUid(LoggedUser.getUid());
+            item.setApprovedAt(now);
+            item.setRejectReason(null);
+            items.save(item);
+            done++;
+        }
+        if (done == 0) return fail("Hakuna mali inayosubiri uthibitisho kati ya ulizochagua.");
+        logger.info("Asset register: {} item(s) approved by {}", done, LoggedUser.getUid());
+        return ok(register(), "Mali " + done + " zimethibitishwa.");
+    }
+
+    @Transactional
+    public Response<AssetDtos.Item> rejectItem(String uid, String reason) {
+        if (reason == null || reason.trim().length() < 3) return fail("Sababu ya kukataa inahitajika.");
+        AssetItem item = items.findByUidAndIsDeletedFalse(uid).orElse(null);
+        if (item == null || !inBranch(item.getBranchUid())) return fail("Mali haijapatikana.");
+        if (item.getProposedQty() == null) return fail("Hakuna idadi inayosubiri uthibitisho.");
+        // Never approved → the whole row is rejected (the proposal stays visible);
+        // otherwise only the proposed change is dropped and the official qty stands.
+        if (item.getApprovedQty() == null) item.setStatus(AssetItem.REJECTED);
+        else item.setProposedQty(null);
+        item.setRejectReason(reason.trim());
+        items.save(item);
+        return ok(toItemDto(item, capitalOf(item)), "Idadi imekataliwa.");
+    }
