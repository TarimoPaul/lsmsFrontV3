+    // ── schedule + status ────────────────────────────────────────────────────────
+
+    @Transactional(readOnly = true)
+    public AssetDtos.Status status() {
+        AssetDtos.Status out = new AssetDtos.Status();
+        List<AssetItem> mine = items.findByIsDeletedFalseOrderByNameAsc().stream()
+                .filter(i -> inBranch(i.getBranchUid())).collect(Collectors.toList());
+        out.setApprovedItems((int) mine.stream()
+                .filter(i -> AssetItem.APPROVED.equals(i.getStatus()) && i.getApprovedQty() != null).count());
+        out.setPendingItems((int) mine.stream().filter(i -> i.getProposedQty() != null
+                && !AssetItem.REJECTED.equals(i.getStatus()) && !AssetItem.RETIRED.equals(i.getStatus())).count());
+
+        List<AssetCountSession> live = sessions.findByIsDeletedFalseOrderByStartedAtDesc().stream()
+                .filter(s -> inBranch(s.getBranchUid()) && !AssetCountSession.CANCELLED.equals(s.getStatus()))
+                .collect(Collectors.toList());
+        live.stream().filter(s -> AssetCountSession.IN_PROGRESS.equals(s.getStatus())).findFirst()
+                .ifPresent(s -> out.setActiveSessionUid(s.getUid()));
+        out.setSessionsAwaitingApproval((int) live.stream()
+                .filter(s -> AssetCountSession.PENDING_APPROVAL.equals(s.getStatus())).count());
+        live.stream().filter(s -> !AssetCountSession.IN_PROGRESS.equals(s.getStatus()))
+                .map(AssetCountSession::getSessionDate).max(LocalDate::compareTo).ifPresent(out::setLastCountDate);
+
+        AssetCountSchedule schedule = scheduleOfBranch();
+        if (schedule != null && Boolean.TRUE.equals(schedule.getIsActive())) {
+            out.setFrequency(schedule.getFrequency());
+            out.setDayOfWeek(schedule.getDayOfWeek());
+            LocalDate today = LocalDate.now();
+            LocalDate periodStart = "WEEKLY".equals(schedule.getFrequency()) && schedule.getDayOfWeek() != null
+                    ? today.with(TemporalAdjusters.previousOrSame(DayOfWeek.of(schedule.getDayOfWeek())))
+                    : today;
+            boolean done = live.stream().anyMatch(s -> !s.getSessionDate().isBefore(periodStart));
+            if (!done && out.getApprovedItems() > 0) {
+                out.setDue(true);
+                out.setDueSince(periodStart);
+            }
+        }
+        return out;
+    }
+
+    @Transactional
+    public Response<AssetDtos.Status> saveSchedule(AssetDtos.Schedule dto) {
+        String frequency = dto == null || dto.getFrequency() == null ? "" : dto.getFrequency().trim().toUpperCase();
+        if (!Set.of("DAILY", "WEEKLY", "OFF").contains(frequency)) {
+            return fail("Ratiba si sahihi (DAILY / WEEKLY / OFF).");
+        }
+        if ("WEEKLY".equals(frequency)
+                && (dto.getDayOfWeek() == null || dto.getDayOfWeek() < 1 || dto.getDayOfWeek() > 7)) {
+            return fail("Ratiba ya wiki inahitaji siku ya wiki (1=Jumatatu .. 7=Jumapili).");
+        }
+        AssetCountSchedule schedule = scheduleOfBranch();
+        if (schedule == null) {
+            if ("OFF".equals(frequency)) return ok(status(), "Hakuna ratiba.");
+            schedule = new AssetCountSchedule();
+            schedule.setUid(UUID.randomUUID().toString());
+            schedule.setBranchUid(LoggedUser.getActiveBranchUid());
+            schedule.setCreatedByUid(LoggedUser.getUid());
+        }
+        if ("OFF".equals(frequency)) {
+            schedule.setIsActive(false);
+            if (schedule.getFrequency() == null) schedule.setFrequency("DAILY");
+        } else {
+            schedule.setIsActive(true);
+            schedule.setFrequency(frequency);
+            schedule.setDayOfWeek("WEEKLY".equals(frequency) ? dto.getDayOfWeek() : null);
+        }
+        schedules.saveAndFlush(schedule);
+        return ok(status(), "Ratiba ya uhakiki wa mali imehifadhiwa.");
+    }
+
+    /** Name of an asset item — lets staff liabilities label an asset charge. */
+    public String assetName(String assetItemUid) {
+        if (assetItemUid == null) return null;
+        return items.findByUidIn(List.of(assetItemUid)).stream().findFirst().map(AssetItem::getName).orElse(null);
+    }
+
+    // ── helpers ──────────────────────────────────────────────────────────────────
+
+    private static boolean hasVariance(AssetCountLine l) {
+        return l.getCountedQty() != null && !l.getCountedQty().equals(l.getExpectedQty());
+    }
+
+    /** Rows without a branch (single-branch data) and callers without one see everything. */
+    private static boolean inBranch(String rowBranch) {
+        String mine = LoggedUser.getActiveBranchUid();
+        return rowBranch == null || mine == null || mine.equals(rowBranch);
+    }
+
+    private AssetCountSession find(String uid) {
+        AssetCountSession s = sessions.findByUidAndIsDeletedFalse(uid).orElse(null);
+        return s != null && inBranch(s.getBranchUid()) ? s : null;
+    }
+
+    private List<AssetCountLine> linesOf(AssetCountSession s) {
+        return lines.findBySessionUidAndIsDeletedFalseOrderByAssetNameAsc(s.getUid());
+    }
+
+    private AssetCountSchedule scheduleOfBranch() {
+        String branch = LoggedUser.getActiveBranchUid();
+        return schedules.findByIsDeletedFalse().stream()
+                .filter(s -> branch == null || s.getBranchUid() == null || branch.equals(s.getBranchUid()))
+                .findFirst().orElse(null);
+    }
+
+    private CapitalExpenditure capitalOf(AssetItem item) {
+        return item.getCapitalExpenditureUid() == null ? null
+                : capitalRepository.findByUid(item.getCapitalExpenditureUid()).orElse(null);
+    }
+
+    private AssetDtos.Item toItemDto(AssetItem i, CapitalExpenditure capital) {
+        AssetDtos.Item dto = new AssetDtos.Item();
+        dto.setUid(i.getUid());
+        dto.setName(i.getName());
+        dto.setLocation(i.getLocation());
+        dto.setCapitalExpenditureUid(i.getCapitalExpenditureUid());
+        dto.setCapitalDecision(i.getCapitalDecision());
+        if (capital != null) {
+            dto.setCapitalStatus(capital.getStatus() != null ? capital.getStatus().name() : null);
+            dto.setCapitalCost(capital.getAmount());
+        }
+        dto.setApprovedQty(i.getApprovedQty());
+        dto.setProposedQty(i.getProposedQty());
+        dto.setUnitValue(i.getUnitValue());
+        dto.setStatus(i.getStatus());
+        dto.setProposedByUid(i.getProposedByUid());
+        dto.setProposedAt(i.getProposedAt());
+        dto.setApprovedByUid(i.getApprovedByUid());
+        dto.setApprovedAt(i.getApprovedAt());
+        dto.setRejectReason(i.getRejectReason());
+        dto.setNotes(i.getNotes());
+        return dto;
+    }
+
+    /** {@code withLines} null = summary row (history list). */
+    private AssetDtos.Session toSessionDto(AssetCountSession s, List<AssetCountLine> withLines) {
+        boolean sighted = !AssetCountSession.IN_PROGRESS.equals(s.getStatus());
+        AssetDtos.Session dto = new AssetDtos.Session();
+        dto.setUid(s.getUid());
+        dto.setBranchUid(s.getBranchUid());
+        dto.setSessionDate(s.getSessionDate());
+        dto.setStatus(s.getStatus());
+        dto.setStartedByUid(s.getStartedByUid());
+        dto.setStartedAt(s.getStartedAt());
+        dto.setCompletedAt(s.getCompletedAt());
+        dto.setApprovedByUid(s.getApprovedByUid());
+        dto.setApprovedAt(s.getApprovedAt());
+        dto.setCancelledReason(s.getCancelledReason());
+        dto.setTotalItems(s.getTotalItems());
+        dto.setItemsCounted(sighted ? s.getItemsCounted()
+                : (int) lines.countBySessionUidAndCountedQtyIsNotNullAndIsDeletedFalse(s.getUid()));
+        if (sighted) dto.setItemsWithVariance(s.getItemsWithVariance());
+        if (withLines != null) {
+            dto.setLines(withLines.stream().map(l -> toLineDto(l, sighted)).collect(Collectors.toList()));
+        }
+        return dto;
+    }
+
+    private AssetDtos.Line toLineDto(AssetCountLine l, boolean sighted) {
+        AssetDtos.Line dto = new AssetDtos.Line();
+        dto.setUid(l.getUid());
+        dto.setAssetItemUid(l.getAssetItemUid());
+        dto.setAssetName(l.getAssetName());
+        dto.setLocation(l.getLocation());
+        dto.setCountedQty(l.getCountedQty());
+        dto.setCountedAt(l.getCountedAt());
+        if (sighted) {
+            dto.setExpectedQty(l.getExpectedQty());
+            if (l.getCountedQty() != null) dto.setVarianceQty(l.getCountedQty() - l.getExpectedQty());
+            dto.setUnitValue(l.getUnitValue());
+            dto.setReason(l.getReason());
+            dto.setNote(l.getNote());
+            dto.setExplainedAt(l.getExplainedAt());
+            dto.setDecision(l.getDecision());
+            dto.setDecisionNote(l.getDecisionNote());
+            dto.setChargeAmount(l.getChargeAmount());
+            dto.setChargeUserUid(l.getChargeUserUid());
+        }
+        return dto;
+    }
+
+    private static <T> Response<T> ok(T data, String message) {
+        return new Response<>(ResponseStatus.Success, data, message);
+    }
+
+    private static <T> Response<T> fail(String message) {
+        return new Response<>(ResponseStatus.Error, null, message);
+    }
+}
