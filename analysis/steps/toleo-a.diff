+    @Transactional
+    public Response<AssetDtos.Session> complete(String sessionUid) {
+        AssetCountSession session = find(sessionUid);
+        if (session == null) return fail("Uhakiki haujapatikana.");
+        if (!AssetCountSession.IN_PROGRESS.equals(session.getStatus())) return fail("Uhakiki huu umeshakamilika.");
+        List<AssetCountLine> all = linesOf(session);
+        long left = all.stream().filter(l -> l.getCountedQty() == null).count();
+        if (left > 0) return fail("Bado mali " + left + " hazijahesabiwa.");
+        int variance = (int) all.stream().filter(AssetCountService::hasVariance).count();
+        session.setItemsCounted(all.size());
+        session.setItemsWithVariance(variance);
+        session.setCompletedAt(LocalDateTime.now());
+        session.setStatus(variance == 0 ? AssetCountSession.MATCHED : AssetCountSession.PENDING_APPROVAL);
+        sessions.save(session);
+        return ok(toSessionDto(session, all), variance == 0
+                ? "Mali zote zimelingana na idadi iliyothibitishwa."
+                : "Uhakiki umekamilika — mali " + variance + " zina tofauti, zinasubiri uamuzi wa CEO.");
+    }
