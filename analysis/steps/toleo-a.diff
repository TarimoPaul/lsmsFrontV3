+package com.Lsms.Counting.Asset;
+
+import com.fasterxml.jackson.annotation.JsonInclude;
+import lombok.Data;
+import lombok.NoArgsConstructor;
+
+import java.math.BigDecimal;
+import java.time.LocalDate;
+import java.time.LocalDateTime;
+import java.util.List;
+
+/** Request / response shapes of the asset register and asset counts. */
+public final class AssetDtos {
+
+    private AssetDtos() {
+    }
+
+    /** A register row, or (uid == null, status NEW) a Capital asset not registered yet. */
+    @Data
+    @NoArgsConstructor
+    public static class Item {
+        private String uid;
+        private String name;
+        private String location;
+        private String capitalExpenditureUid;
+        private String capitalDecision;
+        /** Status of the linked Capital asset (PENDING / APPROVED / DISPOSED ...). */
+        private String capitalStatus;
+        private BigDecimal capitalCost;
+        private Integer approvedQty;
+        private Integer proposedQty;
+        private BigDecimal unitValue;
+        private String status;
+        private String proposedByUid;
+        private LocalDateTime proposedAt;
+        private String approvedByUid;
+        private LocalDateTime approvedAt;
+        private String rejectReason;
+        private String notes;
+    }
+
+    @Data
+    @NoArgsConstructor
+    public static class SaveItem {
+        private String name;
+        private String location;
+        private Integer qty;
+        private BigDecimal unitValue;
+        private String capitalExpenditureUid;
+        /** "DECLINED" = the user chose not to add this asset to Capital. */
+        private String capitalDecision;
+    }
+
+    @Data
+    @NoArgsConstructor
+    public static class Uids {
+        private List<String> uids;
+    }
+
+    @Data
+    @NoArgsConstructor
+    public static class Reason {
+        private String reason;
+        private String note;
+    }
+
+    @Data
+    @NoArgsConstructor
+    public static class Qty {
+        private Integer countedQty;
+    }
+
+    @Data
+    @NoArgsConstructor
+    public static class Decision {
+        private String lineUid;
+        private String decision;
+        private String note;
+        private BigDecimal chargeAmount;
+        private String chargeUserUid;
+    }
+
+    @Data
+    @NoArgsConstructor
+    public static class Approve {
+        private List<Decision> decisions;
+    }
+
+    @Data
+    @NoArgsConstructor
+    public static class Schedule {
+        /** DAILY | WEEKLY | OFF */
+        private String frequency;
+        private Integer dayOfWeek;
+    }
+
+    /** Sighted fields are null (and dropped from the JSON) while the count is IN_PROGRESS. */
+    @Data
+    @NoArgsConstructor
+    @JsonInclude(JsonInclude.Include.NON_NULL)
+    public static class Line {
+        private String uid;
+        private String assetItemUid;
+        private String assetName;
+        private String location;
+        private Integer countedQty;
+        private LocalDateTime countedAt;
+        private Integer expectedQty;
+        private Integer varianceQty;
+        private BigDecimal unitValue;
+        private String reason;
+        private String note;
+        private LocalDateTime explainedAt;
+        private String decision;
+        private String decisionNote;
+        private BigDecimal chargeAmount;
+        private String chargeUserUid;
+    }
+
+    @Data
+    @NoArgsConstructor
+    @JsonInclude(JsonInclude.Include.NON_NULL)
+    public static class Session {
+        private String uid;
+        private String branchUid;
+        private LocalDate sessionDate;
+        private String status;
+        private String startedByUid;
+        private LocalDateTime startedAt;
+        private LocalDateTime completedAt;
+        private String approvedByUid;
+        private LocalDateTime approvedAt;
+        private String cancelledReason;
+        private Integer totalItems;
+        private Integer itemsCounted;
+        private Integer itemsWithVariance;
+        private List<Line> lines;
+    }
+
+    /** Everything the Asset count tab needs to decide what to show first. */
+    @Data
+    @NoArgsConstructor
+    public static class Status {
+        private int approvedItems;
+        private int pendingItems;
+        private String frequency;
+        private Integer dayOfWeek;
+        private boolean due;
+        private LocalDate dueSince;
+        private LocalDate lastCountDate;
+        private String activeSessionUid;
+        private int sessionsAwaitingApproval;
+    }
+}
