+        if (line == null || !sessionUid.equals(line.getSessionUid())) return fail("Mali haijapatikana kwenye uhakiki huu.");
+        if (!hasVariance(line)) return fail("Mali hii haina tofauti.");
+        String code = reason == null ? "" : reason.trim().toUpperCase();
+        if (!REASONS.contains(code)) return fail("Sababu si sahihi.");
+        String text = note == null || note.isBlank() ? null : note.trim();
+        if ("NYINGINE".equals(code) && text == null) return fail("Andika maelezo ya sababu nyingine.");
+        line.setReason(code);
+        line.setNote(text);
+        line.setExplainedAt(LocalDateTime.now());
+        lines.save(line);
