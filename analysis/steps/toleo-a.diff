diff --git a/src/main/resources/db/migration/V128__Asset_Register_And_Asset_Counts.sql b/src/main/resources/db/migration/V128__Asset_Register_And_Asset_Counts.sql
new file mode 100644
index 0000000..2e37632
--- /dev/null
+++ b/src/main/resources/db/migration/V128__Asset_Register_And_Asset_Counts.sql
@@ -0,0 +1,162 @@
+-- V128: Asset register + periodic asset counts (Counting module).
+--
+--  * asset_item           — the register: what the business owns and how many.
+--                           proposed_qty is filled by ASSET_COUNT_MANAGE and only
+--                           becomes approved_qty once ASSET_COUNT_APPROVE (the CEO)
+--                           confirms it. May point at a Capital fixed asset; the
+--                           register itself never posts to the General Ledger.
+--  * asset_count_session  — one verification run (never blocks sales).
+--  * asset_count_line     — one asset in a run; name / expected qty frozen at start.
+--  * asset_count_schedule — DAILY / WEEKLY reminder per branch.
+--
+-- Staff charges raised by an asset count get their own columns in V129; no
+-- existing foreign key is touched here.
+--
+-- status columns are plain VARCHAR without CHECK constraints on purpose (see V111:
+-- stale status CHECKs block new states). Everything is idempotent.
+
+-- ============================================================
+-- 1. asset_item
+-- ============================================================
+CREATE TABLE IF NOT EXISTS asset_item (
+    id                      BIGSERIAL PRIMARY KEY,
+    uid                     VARCHAR(255) NOT NULL,
+    is_active               BOOLEAN NOT NULL DEFAULT TRUE,
+    is_deleted              BOOLEAN NOT NULL DEFAULT FALSE,
+    created_at              TIMESTAMP NOT NULL,
+    updated_at              TIMESTAMP,
+    deleted_at              TIMESTAMP,
+    updated_by              VARCHAR(255),
+    deleted_by              VARCHAR(255),
+
+    branch_uid              VARCHAR(255),
+    name                    VARCHAR(200) NOT NULL,
+    location                VARCHAR(120),
+    capital_expenditure_uid VARCHAR(255),
+    -- LINKED | DECLINED | NULL (not asked yet)
+    capital_decision        VARCHAR(20),
+    approved_qty            INTEGER,
+    proposed_qty            INTEGER,
+    unit_value              NUMERIC(19, 2),
+    -- PENDING | APPROVED | REJECTED | RETIRED
+    status                  VARCHAR(20) NOT NULL DEFAULT 'PENDING',
+    proposed_by_uid         VARCHAR(255),
+    proposed_at             TIMESTAMP,
+    approved_by_uid         VARCHAR(255),
+    approved_at             TIMESTAMP,
+    reject_reason           TEXT,
+    notes                   TEXT,
+    created_by_uid          VARCHAR(255) NOT NULL,
+
+    CONSTRAINT uq_asset_item_uid UNIQUE (uid),
+    CONSTRAINT chk_ai_approved_qty CHECK (approved_qty IS NULL OR approved_qty >= 0),
+    CONSTRAINT chk_ai_proposed_qty CHECK (proposed_qty IS NULL OR proposed_qty >= 0)
+);
+CREATE INDEX IF NOT EXISTS idx_ai_branch  ON asset_item (branch_uid);
+CREATE INDEX IF NOT EXISTS idx_ai_capital ON asset_item (capital_expenditure_uid);
+
+-- ============================================================
+-- 2. asset_count_session
+-- ============================================================
+CREATE TABLE IF NOT EXISTS asset_count_session (
+    id                  BIGSERIAL PRIMARY KEY,
+    uid                 VARCHAR(255) NOT NULL,
+    is_active           BOOLEAN NOT NULL DEFAULT TRUE,
+    is_deleted          BOOLEAN NOT NULL DEFAULT FALSE,
+    created_at          TIMESTAMP NOT NULL,
+    updated_at          TIMESTAMP,
+    deleted_at          TIMESTAMP,
+    updated_by          VARCHAR(255),
+    deleted_by          VARCHAR(255),
+
+    branch_uid          VARCHAR(255),
+    session_date        DATE NOT NULL,
+    -- IN_PROGRESS | PENDING_APPROVAL | APPROVED | MATCHED | CANCELLED
+    status              VARCHAR(20) NOT NULL DEFAULT 'IN_PROGRESS',
+    started_by_uid      VARCHAR(255) NOT NULL,
+    started_at          TIMESTAMP NOT NULL,
+    completed_at        TIMESTAMP,
+    approved_by_uid     VARCHAR(255),
+    approved_at         TIMESTAMP,
+    cancelled_reason    TEXT,
+    total_items         INTEGER NOT NULL DEFAULT 0,
+    items_counted       INTEGER NOT NULL DEFAULT 0,
+    items_with_variance INTEGER,
+
+    CONSTRAINT uq_asset_count_session_uid UNIQUE (uid)
+);
+CREATE INDEX IF NOT EXISTS idx_acs_branch_date ON asset_count_session (branch_uid, session_date);
+
+-- ============================================================
+-- 3. asset_count_line
+-- ============================================================
+CREATE TABLE IF NOT EXISTS asset_count_line (
+    id              BIGSERIAL PRIMARY KEY,
+    uid             VARCHAR(255) NOT NULL,
+    is_active       BOOLEAN NOT NULL DEFAULT TRUE,
+    is_deleted      BOOLEAN NOT NULL DEFAULT FALSE,
+    created_at      TIMESTAMP NOT NULL,
+    updated_at      TIMESTAMP,
+    deleted_at      TIMESTAMP,
+    updated_by      VARCHAR(255),
+    deleted_by      VARCHAR(255),
+
+    session_uid     VARCHAR(255) NOT NULL REFERENCES asset_count_session(uid),
+    asset_item_uid  VARCHAR(255) NOT NULL REFERENCES asset_item(uid),
+    asset_name      VARCHAR(200) NOT NULL,
+    location        VARCHAR(120),
+    expected_qty    INTEGER NOT NULL,
+    unit_value      NUMERIC(19, 2),
+    counted_qty     INTEGER,
+    counted_at      TIMESTAMP,
+    reason          VARCHAR(30),
+    note            TEXT,
+    explained_at    TIMESTAMP,
+    -- ACCEPT | NO_ACTION | CHARGE_STAFF
+    decision        VARCHAR(20),
+    decision_note   TEXT,
+    charge_amount   NUMERIC(19, 2),
+    charge_user_uid VARCHAR(255),
+
+    CONSTRAINT uq_asset_count_line_uid UNIQUE (uid),
+    CONSTRAINT uq_acl_session_item UNIQUE (session_uid, asset_item_uid),
+    CONSTRAINT chk_acl_counted_qty CHECK (counted_qty IS NULL OR counted_qty >= 0)
+);
+CREATE INDEX IF NOT EXISTS idx_acl_item ON asset_count_line (asset_item_uid);
+
+-- ============================================================
+-- 4. asset_count_schedule
+-- ============================================================
+CREATE TABLE IF NOT EXISTS asset_count_schedule (
+    id              BIGSERIAL PRIMARY KEY,
+    uid             VARCHAR(255) NOT NULL,
+    is_active       BOOLEAN NOT NULL DEFAULT TRUE,
+    is_deleted      BOOLEAN NOT NULL DEFAULT FALSE,
+    created_at      TIMESTAMP NOT NULL,
+    updated_at      TIMESTAMP,
+    deleted_at      TIMESTAMP,
+    updated_by      VARCHAR(255),
+    deleted_by      VARCHAR(255),
+
+    branch_uid      VARCHAR(255),
+    -- DAILY | WEEKLY
+    frequency       VARCHAR(10) NOT NULL,
+    day_of_week     INTEGER,
+    created_by_uid  VARCHAR(255) NOT NULL,
+
+    CONSTRAINT uq_asset_count_schedule_uid UNIQUE (uid),
+    CONSTRAINT chk_acsch_day_of_week CHECK (day_of_week IS NULL OR day_of_week BETWEEN 1 AND 7)
+);
+
+-- ============================================================
+-- 5. Permissions — seeded WITHOUT role grants (separation of duties, same rule as
+--    V106): the admin assigns them in the roles screen. ROOT bypasses checks.
+-- ============================================================
+INSERT INTO permissions (uid, name, module, group_name, description, is_active, is_deleted, created_at, updated_at)
+SELECT gen_random_uuid()::VARCHAR(255), p.name, 'COUNTING', 'ASSET_COUNTING', p.description,
+       TRUE, FALSE, NOW(), NOW()
+FROM (VALUES
+    ('ASSET_COUNT_MANAGE',  'Jaza na hariri orodha ya mali za duka na idadi yake (inasubiri uthibitisho wa CEO)'),
+    ('ASSET_COUNT_APPROVE', 'Thibitisha idadi ya mali, amua tofauti za uhakiki wa mali na weka ratiba ya uhakiki')
+) AS p(name, description)
+WHERE NOT EXISTS (SELECT 1 FROM permissions x WHERE x.name = p.name);
diff --git a/src/main/resources/db/migration/V129__Staff_Liability_Asset_Source.sql b/src/main/resources/db/migration/V129__Staff_Liability_Asset_Source.sql
new file mode 100644
index 0000000..0867f72
--- /dev/null
+++ b/src/main/resources/db/migration/V129__Staff_Liability_Asset_Source.sql
@@ -0,0 +1,73 @@
+-- V129: Staff liabilities may also come from an asset count.
+--
+-- A missing asset charged to staff reuses staff_liability / staff_liability_item,
+-- but through its OWN columns, each with a real foreign key:
+--
+--   staff_liability.asset_session_uid     -> asset_count_session(uid)
+--   staff_liability_item.asset_item_uid   -> asset_item(uid)
+--   staff_liability_item.asset_line_uid   -> asset_count_line(uid)
+--
+-- The stock-count columns (session_uid, product_uid, counting_line_uid) keep their
+-- foreign keys to counting_session / products / counting_line; only their NOT NULL
+-- is relaxed. A CHECK on each table then guarantees exactly ONE source per row.
+--
+-- Every row that exists today is a stock-count row with all three stock columns
+-- set, so it satisfies the new CHECKs unchanged. Verify before running:
+--   SELECT count(*) FROM staff_liability      WHERE session_uid IS NULL;
+--   SELECT count(*) FROM staff_liability_item WHERE product_uid IS NULL OR counting_line_uid IS NULL;
+-- (both must be 0 — the columns are NOT NULL until this migration). Idempotent.
+
+-- ============================================================
+-- 1. staff_liability (header)
+-- ============================================================
+ALTER TABLE staff_liability
+    ADD COLUMN IF NOT EXISTS asset_session_uid VARCHAR(255);
+
+ALTER TABLE staff_liability ALTER COLUMN session_uid DROP NOT NULL;
+
+ALTER TABLE staff_liability DROP CONSTRAINT IF EXISTS fk_sl_asset_session;
+ALTER TABLE staff_liability ADD CONSTRAINT fk_sl_asset_session
+    FOREIGN KEY (asset_session_uid) REFERENCES asset_count_session(uid);
+
+ALTER TABLE staff_liability DROP CONSTRAINT IF EXISTS chk_sl_one_source;
+ALTER TABLE staff_liability ADD CONSTRAINT chk_sl_one_source
+    CHECK (num_nonnulls(session_uid, asset_session_uid) = 1);
+
+CREATE INDEX IF NOT EXISTS idx_sl_asset_session ON staff_liability (asset_session_uid);
+
+-- ============================================================
+-- 2. staff_liability_item
+-- ============================================================
+ALTER TABLE staff_liability_item
+    ADD COLUMN IF NOT EXISTS asset_item_uid VARCHAR(255),
+    ADD COLUMN IF NOT EXISTS asset_line_uid VARCHAR(255);
+
+ALTER TABLE staff_liability_item ALTER COLUMN product_uid DROP NOT NULL;
+ALTER TABLE staff_liability_item ALTER COLUMN counting_line_uid DROP NOT NULL;
+
+ALTER TABLE staff_liability_item DROP CONSTRAINT IF EXISTS fk_sli_asset_item;
+ALTER TABLE staff_liability_item ADD CONSTRAINT fk_sli_asset_item
+    FOREIGN KEY (asset_item_uid) REFERENCES asset_item(uid);
+
+ALTER TABLE staff_liability_item DROP CONSTRAINT IF EXISTS fk_sli_asset_line;
+ALTER TABLE staff_liability_item ADD CONSTRAINT fk_sli_asset_line
+    FOREIGN KEY (asset_line_uid) REFERENCES asset_count_line(uid);
+
+-- Either a stock line (product + counting line) or an asset line (asset item +
+-- asset count line) — never a mix, never neither.
+ALTER TABLE staff_liability_item DROP CONSTRAINT IF EXISTS chk_sli_one_source;
+ALTER TABLE staff_liability_item ADD CONSTRAINT chk_sli_one_source
+    CHECK (
+        (product_uid IS NOT NULL AND counting_line_uid IS NOT NULL
+            AND asset_item_uid IS NULL AND asset_line_uid IS NULL)
+        OR
+        (product_uid IS NULL AND counting_line_uid IS NULL
+            AND asset_item_uid IS NOT NULL AND asset_line_uid IS NOT NULL)
+    );
+
+-- Idempotency backstop, same rule as uq_sli_counting_line: an asset count line can
+-- only ever be charged once. (uq_sli_counting_line stays; NULLs never collide.)
+ALTER TABLE staff_liability_item DROP CONSTRAINT IF EXISTS uq_sli_asset_line;
+ALTER TABLE staff_liability_item ADD CONSTRAINT uq_sli_asset_line UNIQUE (asset_line_uid);
+
+CREATE INDEX IF NOT EXISTS idx_sli_asset_item ON staff_liability_item (asset_item_uid);
