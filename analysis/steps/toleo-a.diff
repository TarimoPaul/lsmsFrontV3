+package com.Lsms.Counting.Asset;
+
+import com.Lsms.uaa.entity.BaseEntity;
+import jakarta.persistence.Column;
+import jakarta.persistence.Entity;
+import jakarta.persistence.Table;
+import lombok.Data;
+import lombok.NoArgsConstructor;
+
+/**
+ * How often a branch should verify its assets: DAILY or WEEKLY (dayOfWeek
+ * ISO-8601, 1=Mon..7=Sun). A reminder only — unlike counting_schedule it never
+ * blocks sales. One row per branch; isActive=false means "no schedule".
+ */
+@Entity
+@Table(name = "asset_count_schedule")
+@Data
+@NoArgsConstructor
+public class AssetCountSchedule extends BaseEntity {
+
+    @Column(name = "branch_uid")
+    private String branchUid;
+
+    @Column(name = "frequency", nullable = false, length = 10)
+    private String frequency;
+
+    @Column(name = "day_of_week")
+    private Integer dayOfWeek;
+
+    @Column(name = "created_by_uid", nullable = false)
+    private String createdByUid;
+}
