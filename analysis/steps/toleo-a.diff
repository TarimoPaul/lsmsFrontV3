+package com.Lsms.Counting.Asset;
+
+import com.Lsms.uaa.entity.BaseEntity;
+import jakarta.persistence.Column;
+import jakarta.persistence.Entity;
+import jakarta.persistence.Index;
+import jakarta.persistence.Table;
+import lombok.Data;
+import lombok.NoArgsConstructor;
+
+import java.time.LocalDate;
+import java.time.LocalDateTime;
+
+/**
+ * One periodic verification of the asset register. Unlike a stock count it never
+ * blocks sales. IN_PROGRESS → MATCHED (every asset equals its approved quantity,
+ * nothing to decide) or PENDING_APPROVAL (the CEO decides each difference) →
+ * APPROVED. CANCELLED is the escape hatch for a count that was abandoned.
+ */
+@Entity
+@Table(name = "asset_count_session",
+        indexes = @Index(name = "idx_acs_branch_date", columnList = "branch_uid, session_date"))
+@Data
+@NoArgsConstructor
+public class AssetCountSession extends BaseEntity {
+
+    public static final String IN_PROGRESS = "IN_PROGRESS";
+    public static final String PENDING_APPROVAL = "PENDING_APPROVAL";
+    public static final String APPROVED = "APPROVED";
+    public static final String MATCHED = "MATCHED";
+    public static final String CANCELLED = "CANCELLED";
+
+    @Column(name = "branch_uid")
+    private String branchUid;
+
+    @Column(name = "session_date", nullable = false)
+    private LocalDate sessionDate;
+
+    @Column(name = "status", nullable = false, length = 20)
+    private String status = IN_PROGRESS;
+
+    @Column(name = "started_by_uid", nullable = false)
+    private String startedByUid;
+
+    @Column(name = "started_at", nullable = false)
+    private LocalDateTime startedAt;
+
+    @Column(name = "completed_at")
+    private LocalDateTime completedAt;
+
+    @Column(name = "approved_by_uid")
+    private String approvedByUid;
+
+    @Column(name = "approved_at")
+    private LocalDateTime approvedAt;
+
+    @Column(name = "cancelled_reason", columnDefinition = "TEXT")
+    private String cancelledReason;
+
+    @Column(name = "total_items", nullable = false)
+    private Integer totalItems = 0;
+
+    /** Frozen at completion; while IN_PROGRESS it is derived from the lines. */
+    @Column(name = "items_counted", nullable = false)
+    private Integer itemsCounted = 0;
+
+    @Column(name = "items_with_variance")
+    private Integer itemsWithVariance;
+}
