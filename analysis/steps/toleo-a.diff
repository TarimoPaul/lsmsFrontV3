+package com.Lsms.Counting.Asset;
+
+import com.Lsms.uaa.entity.BaseEntity;
+import jakarta.persistence.Column;
+import jakarta.persistence.Entity;
+import jakarta.persistence.Index;
+import jakarta.persistence.Table;
+import jakarta.persistence.UniqueConstraint;
+import lombok.Data;
+import lombok.NoArgsConstructor;
+
+import java.math.BigDecimal;
+import java.time.LocalDateTime;
+
+/**
+ * One asset within an asset count. Name, expected quantity and unit value are
+ * frozen at session start, so a later register change never rewrites history.
+ *
+ * BLIND RULE: expectedQty must not reach the counter while the session is
+ * IN_PROGRESS — enforced where the DTO is built (AssetCountService).
+ */
+@Entity
+@Table(name = "asset_count_line",
+        uniqueConstraints = @UniqueConstraint(name = "uq_acl_session_item",
+                columnNames = {"session_uid", "asset_item_uid"}),
+        indexes = @Index(name = "idx_acl_item", columnList = "asset_item_uid"))
+@Data
+@NoArgsConstructor
+public class AssetCountLine extends BaseEntity {
+
+    public static final String ACCEPT = "ACCEPT";
+    public static final String NO_ACTION = "NO_ACTION";
+    public static final String CHARGE_STAFF = "CHARGE_STAFF";
+
+    @Column(name = "session_uid", nullable = false)
+    private String sessionUid;
+
+    @Column(name = "asset_item_uid", nullable = false)
+    private String assetItemUid;
+
+    @Column(name = "asset_name", nullable = false, length = 200)
+    private String assetName;
+
+    @Column(name = "location", length = 120)
+    private String location;
+
+    @Column(name = "expected_qty", nullable = false)
+    private Integer expectedQty;
+
+    @Column(name = "unit_value", precision = 19, scale = 2)
+    private BigDecimal unitValue;
+
+    @Column(name = "counted_qty")
+    private Integer countedQty;
+
+    @Column(name = "counted_at")
+    private LocalDateTime countedAt;
+
+    /** Counter's explanation of a difference (AssetCountService.REASONS). */
+    @Column(name = "reason", length = 30)
+    private String reason;
+
+    @Column(name = "note", columnDefinition = "TEXT")
+    private String note;
+
+    @Column(name = "explained_at")
+    private LocalDateTime explainedAt;
+
+    /** CEO's decision on a difference: ACCEPT / NO_ACTION / CHARGE_STAFF. */
+    @Column(name = "decision", length = 20)
+    private String decision;
+
+    @Column(name = "decision_note", columnDefinition = "TEXT")
+    private String decisionNote;
+
+    @Column(name = "charge_amount", precision = 19, scale = 2)
+    private BigDecimal chargeAmount;
+
+    @Column(name = "charge_user_uid")
+    private String chargeUserUid;
+}
