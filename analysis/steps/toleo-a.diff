@@ -0,0 +1,704 @@
+package com.Lsms.Counting.Asset;
+
+import com.Lsms.CapitalAndExpenditure.Entity.CapitalExpenditure;
+import com.Lsms.CapitalAndExpenditure.Repository.CapitalExpenditureRepository;
+import com.Lsms.CapitalAndExpenditure.gl.PostingEngine;
+import com.Lsms.Counting.Entity.StaffLiability;
+import com.Lsms.Counting.Entity.StaffLiabilityItem;
+import com.Lsms.Counting.Enums.StaffLiabilityStatus;
+import com.Lsms.Counting.Repository.StaffLiabilityItemRepository;
+import com.Lsms.Counting.Repository.StaffLiabilityRepository;
+import com.Lsms.Enums.ExpenditureStatus;
+import com.Lsms.uaa.utils.LoggedUser;
+import com.Lsms.uaa.utils.Response;
+import com.Lsms.uaa.utils.ResponseStatus;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.time.DayOfWeek;
+import java.time.LocalDate;
+import java.time.LocalDateTime;
+import java.time.temporal.TemporalAdjusters;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import java.util.Set;
+import java.util.UUID;
+import java.util.stream.Collectors;
+
+/**
+ * Asset register + periodic asset counts.
+ *
+ *  1. Register — ASSET_COUNT_MANAGE proposes a quantity per asset (Capital fixed
+ *     assets are offered as ready-made rows); ASSET_COUNT_APPROVE (the CEO)
+ *     confirms it. Only confirmed quantities are counted against.
+ *  2. Count — COUNTING_PERFORM counts every confirmed asset BLIND, completes;
+ *     no difference → MATCHED, otherwise the counter explains each difference
+ *     and the CEO decides it: ACCEPT (the counted quantity becomes official),
+ *     NO_ACTION, or CHARGE_STAFF (official quantity updated + a staff liability).
+ *  3. Schedule — DAILY / WEEKLY reminder; never blocks sales.
+ *
+ * Permissions are enforced at the controller. Rows are scoped to the caller's
+ * active branch.
+ */
+@Service
+public class AssetCountService {
+
+    private static final Logger logger = LoggerFactory.getLogger(AssetCountService.class);
+
+    /** Counter's explanation of a difference. */
+    static final Set<String> REASONS =
+            Set.of("IMEHARIBIKA", "IMEPOTEA", "IMEHAMISHWA", "IMEONGEZWA", "SIJUI", "NYINGINE");
+    private static final int MAX_QTY = 1_000_000;
+
+    private final AssetItemRepository items;
+    private final AssetCountSessionRepository sessions;
+    private final AssetCountLineRepository lines;
+    private final AssetCountScheduleRepository schedules;
+    private final CapitalExpenditureRepository capitalRepository;
+    private final StaffLiabilityRepository liabilityRepository;
+    private final StaffLiabilityItemRepository liabilityItemRepository;
+    private final PostingEngine postingEngine;
+
+    public AssetCountService(AssetItemRepository items,
+                             AssetCountSessionRepository sessions,
+                             AssetCountLineRepository lines,
+                             AssetCountScheduleRepository schedules,
+                             CapitalExpenditureRepository capitalRepository,
+                             StaffLiabilityRepository liabilityRepository,
+                             StaffLiabilityItemRepository liabilityItemRepository,
+                             PostingEngine postingEngine) {
+        this.items = items;
+        this.sessions = sessions;
+        this.lines = lines;
+        this.schedules = schedules;
+        this.capitalRepository = capitalRepository;
+        this.liabilityRepository = liabilityRepository;
+        this.liabilityItemRepository = liabilityItemRepository;
+        this.postingEngine = postingEngine;
+    }
+
+    // ── register ─────────────────────────────────────────────────────────────────
+
+    /** Register rows of the branch, then Capital fixed assets nobody registered yet. */
+    @Transactional(readOnly = true)
+    public List<AssetDtos.Item> register() {
+        List<AssetItem> all = items.findByIsDeletedFalseOrderByNameAsc();
+        Map<String, CapitalExpenditure> capital = capitalRepository.findAllAssets().stream()
+                .collect(Collectors.toMap(CapitalExpenditure::getUid, c -> c, (a, b) -> a, LinkedHashMap::new));
+        Set<String> linked = all.stream().map(AssetItem::getCapitalExpenditureUid)
+                .filter(Objects::nonNull).collect(Collectors.toSet());
+
+        List<AssetDtos.Item> out = all.stream().filter(i -> inBranch(i.getBranchUid()))
+                .map(i -> toItemDto(i, capital.get(i.getCapitalExpenditureUid())))
+                .collect(Collectors.toCollection(ArrayList::new));
+        for (CapitalExpenditure c : capital.values()) {
+            if (linked.contains(c.getUid()) || Boolean.TRUE.equals(c.getIsDeleted())) continue;
+            if (c.getStatus() != ExpenditureStatus.APPROVED && c.getStatus() != ExpenditureStatus.PENDING) continue;
+            AssetDtos.Item dto = new AssetDtos.Item();
+            dto.setName(c.getDescription());
+            dto.setCapitalExpenditureUid(c.getUid());
+            dto.setCapitalDecision("LINKED");
+            dto.setCapitalStatus(c.getStatus().name());
+            dto.setCapitalCost(c.getAmount());
+            dto.setStatus("NEW");
+            out.add(dto);
+        }
+        return out;
+    }
+
+    @Transactional
+    public Response<AssetDtos.Item> saveItem(String uid, AssetDtos.SaveItem dto) {
+        if (dto == null) return fail("Taarifa za mali zinahitajika.");
+        boolean isNew = uid == null;
+        AssetItem item;
+        if (isNew) {
+            item = new AssetItem();
+            item.setUid(UUID.randomUUID().toString());
+            item.setBranchUid(LoggedUser.getActiveBranchUid());
+            item.setCreatedByUid(LoggedUser.getUid());
+        } else {
+            item = items.findByUidAndIsDeletedFalse(uid).orElse(null);
+            if (item == null || !inBranch(item.getBranchUid())) return fail("Mali haijapatikana.");
+            if (AssetItem.RETIRED.equals(item.getStatus())) return fail("Mali hii imeondolewa kwenye orodha.");
+        }
+
+        String name = dto.getName() != null ? dto.getName().trim() : (isNew ? "" : item.getName());
+        if (name.length() < 2) return fail("Jina la mali linahitajika (angalau herufi 2).");
+        if (name.length() > 200) return fail("Jina la mali ni refu mno.");
+        List<AssetItem> others = items.findByIsDeletedFalseOrderByNameAsc().stream()
+                .filter(o -> !o.getUid().equals(item.getUid())).collect(Collectors.toList());
+        boolean duplicate = others.stream().anyMatch(o -> inBranch(o.getBranchUid())
+                && !AssetItem.RETIRED.equals(o.getStatus()) && o.getName().equalsIgnoreCase(name));
+        if (duplicate) return fail("Mali yenye jina hili tayari ipo kwenye orodha: " + name);
+        item.setName(name);
+        if (dto.getLocation() != null) {
+            String loc = dto.getLocation().trim();
+            item.setLocation(loc.isEmpty() ? null : loc.substring(0, Math.min(120, loc.length())));
+        }
+        if (dto.getUnitValue() != null) {
+            if (dto.getUnitValue().signum() < 0) return fail("Thamani ya kimoja haiwezi kuwa hasi.");
+            item.setUnitValue(dto.getUnitValue().signum() == 0 ? null : dto.getUnitValue());
+        }
+
+        String capitalUid = dto.getCapitalExpenditureUid();
+        if (capitalUid != null && !capitalUid.isBlank()) {
+            if (!capitalUid.equals(item.getCapitalExpenditureUid())) {
+                CapitalExpenditure ce = capitalRepository.findByUid(capitalUid).orElse(null);
+                if (ce == null || !ce.isAsset()) return fail("Mali ya Capital haijapatikana.");
+                AssetItem taken = others.stream()
+                        .filter(o -> capitalUid.equals(o.getCapitalExpenditureUid())).findFirst().orElse(null);
+                if (taken != null) return fail("Mali hii ya Capital tayari imeunganishwa na: " + taken.getName());
+                item.setCapitalExpenditureUid(capitalUid);
+            }
+            item.setCapitalDecision("LINKED");
+        } else if ("DECLINED".equalsIgnoreCase(dto.getCapitalDecision()) && item.getCapitalExpenditureUid() == null) {
+            item.setCapitalDecision("DECLINED");
+        }
+
+        Integer qty = dto.getQty();
+        if (isNew && qty == null) return fail("Idadi inahitajika.");
+        if (qty != null) {
+            if (qty < 0 || qty > MAX_QTY) return fail("Idadi si sahihi.");
+            boolean rejected = AssetItem.REJECTED.equals(item.getStatus());
+            if (qty.equals(item.getApprovedQty())) {
+                item.setProposedQty(null);
+            } else if (rejected || !qty.equals(item.getProposedQty())) {
+                item.setProposedQty(qty);
+                item.setProposedByUid(LoggedUser.getUid());
+                item.setProposedAt(LocalDateTime.now());
+                item.setRejectReason(null);
+            }
+            if (rejected) item.setStatus(AssetItem.PENDING);
+        }
+        items.save(item);
+        return ok(toItemDto(item, capitalOf(item)), "Mali imehifadhiwa.");
+    }
