@@ -0,0 +1,94 @@
+package com.Lsms.Counting.Asset;
+
+import com.Lsms.uaa.entity.BaseEntity;
+import jakarta.persistence.Column;
+import jakarta.persistence.Entity;
+import jakarta.persistence.Index;
+import jakarta.persistence.Table;
+import lombok.Data;
+import lombok.NoArgsConstructor;
+
+import java.math.BigDecimal;
+import java.time.LocalDateTime;
+
+/**
+ * One line of the asset register (friji, viti, kreti ...): how many the business
+ * is supposed to have. The quantity is PROPOSED by an ASSET_COUNT_MANAGE holder
+ * and only becomes official ({@code approvedQty}) once an ASSET_COUNT_APPROVE
+ * holder (the CEO) confirms it — periodic asset counts are checked against
+ * {@code approvedQty} only.
+ *
+ * An item may point at a Capital fixed asset ({@code capitalExpenditureUid}); the
+ * register never posts to the General Ledger itself. {@code capitalDecision}
+ * remembers the answer to "should this be added to Capital?" for items that were
+ * not created from one: LINKED, DECLINED, or null (not asked yet).
+ *
+ * status is a plain string (PENDING / APPROVED / REJECTED / RETIRED) on purpose —
+ * Hibernate generates CHECK constraints for @Enumerated columns (see V111).
+ */
+@Entity
+@Table(name = "asset_item",
+        indexes = {
+                @Index(name = "idx_ai_branch", columnList = "branch_uid"),
+                @Index(name = "idx_ai_capital", columnList = "capital_expenditure_uid")
+        })
+@Data
+@NoArgsConstructor
+public class AssetItem extends BaseEntity {
+
+    public static final String PENDING = "PENDING";
+    public static final String APPROVED = "APPROVED";
+    public static final String REJECTED = "REJECTED";
+    public static final String RETIRED = "RETIRED";
+
+    @Column(name = "branch_uid")
+    private String branchUid;
+
+    @Column(name = "name", nullable = false, length = 200)
+    private String name;
+
+    @Column(name = "location", length = 120)
+    private String location;
+
+    @Column(name = "capital_expenditure_uid")
+    private String capitalExpenditureUid;
+
+    @Column(name = "capital_decision", length = 20)
+    private String capitalDecision;
+
+    /** Official quantity — null until the first approval. */
+    @Column(name = "approved_qty")
+    private Integer approvedQty;
+
+    /** Quantity waiting for approval — null when nothing is pending. */
+    @Column(name = "proposed_qty")
+    private Integer proposedQty;
+
+    /** Optional value of ONE unit — only used to suggest a staff charge. */
+    @Column(name = "unit_value", precision = 19, scale = 2)
+    private BigDecimal unitValue;
+
+    @Column(name = "status", nullable = false, length = 20)
+    private String status = PENDING;
+
+    @Column(name = "proposed_by_uid")
+    private String proposedByUid;
+
+    @Column(name = "proposed_at")
+    private LocalDateTime proposedAt;
+
+    @Column(name = "approved_by_uid")
+    private String approvedByUid;
+
+    @Column(name = "approved_at")
+    private LocalDateTime approvedAt;
+
+    @Column(name = "reject_reason", columnDefinition = "TEXT")
+    private String rejectReason;
+
+    @Column(name = "notes", columnDefinition = "TEXT")
+    private String notes;
+
+    @Column(name = "created_by_uid", nullable = false)
+    private String createdByUid;
+}
