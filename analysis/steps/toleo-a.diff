+    /**
+     * The CEO decides every difference. Not wrapped in a catch-all on purpose: a
+     * failed staff-charge GL post must roll the whole approval back (the GL posts
+     * run last, each in its own transaction).
+     */
+    @Transactional
+    public Response<AssetDtos.Session> approve(String sessionUid, List<AssetDtos.Decision> decisions) {
+        AssetCountSession session = find(sessionUid);
+        if (session == null) return fail("Uhakiki haujapatikana.");
+        if (!AssetCountSession.PENDING_APPROVAL.equals(session.getStatus())) {
+            return fail("Uhakiki huu hausubiri uamuzi.");
+        }
+        String approverUid = LoggedUser.getUid();
+        if (Objects.equals(approverUid, session.getStartedByUid()) && !LoggedUser.hasAuthority("ROOT_USER")) {
+            return fail("Huwezi kuthibitisha uhakiki ulioufanya mwenyewe.");
+        }
+        Map<String, AssetDtos.Decision> byLine = new HashMap<>();
+        if (decisions != null) decisions.forEach(d -> { if (d != null && d.getLineUid() != null) byLine.put(d.getLineUid(), d); });
+
+        List<AssetCountLine> all = linesOf(session);
+        List<AssetCountLine> differing = all.stream().filter(AssetCountService::hasVariance).collect(Collectors.toList());
+        for (AssetCountLine line : differing) {
+            AssetDtos.Decision d = byLine.get(line.getUid());
+            String decision = d == null || d.getDecision() == null ? "" : d.getDecision().trim().toUpperCase();
+            if (!Set.of(AssetCountLine.ACCEPT, AssetCountLine.NO_ACTION, AssetCountLine.CHARGE_STAFF).contains(decision)) {
+                return fail("Kila mali yenye tofauti inahitaji uamuzi: " + line.getAssetName());
+            }
+            if (AssetCountLine.CHARGE_STAFF.equals(decision)) {
+                if (line.getCountedQty() >= line.getExpectedQty()) {
+                    return fail("Mali iliyozidi haiwezi kutozwa mfanyakazi: " + line.getAssetName());
+                }
+                if (d.getChargeAmount() == null || d.getChargeAmount().signum() <= 0) {
+                    return fail("Weka kiasi cha kumtoza mfanyakazi: " + line.getAssetName());
+                }
+            }
+        }
+
+        LocalDateTime now = LocalDateTime.now();
+        Map<String, AssetItem> itemsByUid = items.findByUidIn(
+                        differing.stream().map(AssetCountLine::getAssetItemUid).collect(Collectors.toList()))
+                .stream().collect(Collectors.toMap(AssetItem::getUid, i -> i, (a, b) -> a));
+        Map<String, StaffLiability> headers = new HashMap<>();
+        List<AssetCountLine> charged = new ArrayList<>();
+
+        for (AssetCountLine line : differing) {
+            AssetDtos.Decision d = byLine.get(line.getUid());
+            String decision = d.getDecision().trim().toUpperCase();
+            line.setDecision(decision);
+            line.setDecisionNote(d.getNote() == null || d.getNote().isBlank() ? null : d.getNote().trim());
+
+            if (!AssetCountLine.NO_ACTION.equals(decision)) {
+                AssetItem item = itemsByUid.get(line.getAssetItemUid());
+                if (item != null && !Boolean.TRUE.equals(item.getIsDeleted())
+                        && !AssetItem.RETIRED.equals(item.getStatus())) {
+                    item.setApprovedQty(line.getCountedQty());
+                    items.save(item);
+                }
+            }
+            if (AssetCountLine.CHARGE_STAFF.equals(decision)) {
+                String userUid = d.getChargeUserUid() == null || d.getChargeUserUid().isBlank()
+                        ? session.getStartedByUid() : d.getChargeUserUid().trim();
+                BigDecimal amount = d.getChargeAmount().setScale(2, RoundingMode.HALF_UP);
+                int missing = line.getExpectedQty() - line.getCountedQty();
+
+                StaffLiability header = headers.computeIfAbsent(userUid, u -> liabilityRepository
+                        .findByUserUidAndAssetSessionUidAndIsDeletedFalse(u, sessionUid).orElseGet(() -> {
+                            StaffLiability h = new StaffLiability();
+                            h.setUid(UUID.randomUUID().toString());
+                            h.setUserUid(u);
+                            h.setAssetSessionUid(sessionUid);
+                            h.setBranchUid(session.getBranchUid());
+                            h.setAmount(BigDecimal.ZERO);
+                            h.setStatus(StaffLiabilityStatus.OPEN);
+                            h.setNotes("Uhakiki wa mali " + session.getSessionDate());
+                            h.setCreatedBy(approverUid);
+                            return liabilityRepository.save(h);
+                        }));
+
+                // Same header/item tables as stock shortages, through the asset columns
+                // of V129 (the stock columns stay null on an asset charge).
+                StaffLiabilityItem li = new StaffLiabilityItem();
+                li.setUid(UUID.randomUUID().toString());
+                li.setLiabilityUid(header.getUid());
+                li.setAssetItemUid(line.getAssetItemUid());
+                li.setAssetLineUid(line.getUid());
+                li.setExpectedQty(line.getExpectedQty());
+                li.setCountedQty(line.getCountedQty());
+                li.setVarianceQty(-missing);
+                li.setUnitCostUsed(amount.divide(BigDecimal.valueOf(missing), 2, RoundingMode.HALF_UP));
+                li.setLineAmount(amount);
+                li.setApproverNote(line.getDecisionNote());
+                li.setCreatedBy(approverUid);
+                liabilityItemRepository.save(li);
+
+                header.setAmount(header.getAmount().add(amount));
+                liabilityRepository.save(header);
+                line.setChargeAmount(amount);
+                line.setChargeUserUid(userUid);
+                charged.add(line);
+            }
+        }
+        lines.saveAll(differing);
+        session.setStatus(AssetCountSession.APPROVED);
+        session.setApprovedByUid(approverUid);
+        session.setApprovedAt(now);
+        sessions.saveAndFlush(session);
+
+        if (!charged.isEmpty()) {
+            try (AutoCloseable ignored = postingEngine.withThrowOnError()) {
+                for (AssetCountLine line : charged) {
+                    postingEngine.postAssetStaffCharge("ASSETCHG:" + line.getUid(), "ASSETCOUNT-" + sessionUid,
+                            now.toLocalDate(), line.getAssetName(), line.getChargeAmount(), LoggedUser.getName());
+                }
+            } catch (RuntimeException e) {
+                throw e;
+            } catch (Exception e) {
+                throw new IllegalStateException(e);
+            }
+        }
+        logger.info("Asset count {} approved by {} ({} difference(s), {} charged)",
+                sessionUid, approverUid, differing.size(), charged.size());
+        return ok(toSessionDto(session, all), "Uhakiki wa mali umethibitishwa.");
+    }
+
+    @Transactional
+    public Response<AssetDtos.Session> cancel(String sessionUid, String reason) {
+        if (reason == null || reason.trim().length() < 3) return fail("Sababu ya kufuta uhakiki inahitajika.");
+        AssetCountSession session = find(sessionUid);
+        if (session == null) return fail("Uhakiki haujapatikana.");
+        if (!AssetCountSession.IN_PROGRESS.equals(session.getStatus())
+                && !AssetCountSession.PENDING_APPROVAL.equals(session.getStatus())) {
+            return fail("Uhakiki uliokamilika hauwezi kufutwa.");
+        }
+        session.setStatus(AssetCountSession.CANCELLED);
+        session.setCancelledReason(reason.trim());
+        sessions.save(session);
+        return ok(toSessionDto(session, null), "Uhakiki umefutwa.");
+    }
