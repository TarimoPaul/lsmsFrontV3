+    @Transactional
+    public Response<AssetDtos.Session> start() {
+        boolean open = sessions.findByStatusAndIsDeletedFalseOrderByStartedAtDesc(AssetCountSession.IN_PROGRESS)
+                .stream().anyMatch(s -> inBranch(s.getBranchUid()));
+        if (open) return fail("Kuna uhakiki wa mali unaoendelea — umalizwe kwanza.");
+        List<AssetItem> confirmed = items.findByIsDeletedFalseOrderByNameAsc().stream()
+                .filter(i -> inBranch(i.getBranchUid()) && AssetItem.APPROVED.equals(i.getStatus())
+                        && i.getApprovedQty() != null)
+                .collect(Collectors.toList());
+        if (confirmed.isEmpty()) {
+            return fail("Hakuna mali iliyothibitishwa na CEO bado — orodha ya mali ijazwe na kuthibitishwa kwanza.");
+        }
+
+        AssetCountSession session = new AssetCountSession();
+        session.setUid(UUID.randomUUID().toString());
+        session.setBranchUid(LoggedUser.getActiveBranchUid());
+        session.setSessionDate(LocalDate.now());
+        session.setStartedByUid(LoggedUser.getUid());
+        session.setStartedAt(LocalDateTime.now());
+        session.setTotalItems(confirmed.size());
+        sessions.save(session);
+
+        List<AssetCountLine> created = new ArrayList<>();
+        for (AssetItem item : confirmed) {
+            AssetCountLine line = new AssetCountLine();
+            line.setUid(UUID.randomUUID().toString());
+            line.setSessionUid(session.getUid());
+            line.setAssetItemUid(item.getUid());
+            line.setAssetName(item.getName());
+            line.setLocation(item.getLocation());
+            line.setExpectedQty(item.getApprovedQty());
+            line.setUnitValue(item.getUnitValue());
+            created.add(line);
+        }
+        lines.saveAll(created);
+        return ok(toSessionDto(session, created), "Uhakiki wa mali umeanza.");
+    }
