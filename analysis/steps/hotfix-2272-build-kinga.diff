     if (-not $PreflightOnly) { Assert-CleanTree $RepoRoot }   # -PreflightOnly only reads and never deploys
+    if (-not $PreflightOnly) { Assert-ReleaseBranch $RepoRoot }   # main or hotfix/* only, no migration main lacks
 
     # A build needs JDK 21. Found here, before anything is asked or changed; never falls back to another JDK.
     $jdk21 = $null
